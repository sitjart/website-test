---
import Crumbs from '../../components/Crumbs.astro';
// People profile: sidebar layout (as on the WordPress site) – photo, honorific above the name,
// role, organisation, roles in ELIXIR-UK and links on the left; bio and related items on the right.
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Avatar from '../../components/Avatar.astro';
import RemoteImage from '../../components/RemoteImage.astro';
import SmartTabs from '../../components/SmartTabs.astro';
import { DIRECTORY } from '../../lib/graph';
import { localAsset } from '../../lib/assets';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const people = await getCollection('people');
  return people.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const p = entry.data;
const org = p.institutionSlug ? DIRECTORY.members.records.find((m) => m.slug === p.institutionSlug) : undefined;
const leads = p.leads.map((s) => DIRECTORY.activities.records.find((a) => a.slug === s)!).filter(Boolean);
const links = [
  ...(p.orcid ? [{ label: 'ORCID', href: p.orcid.startsWith('http') ? p.orcid : `https://orcid.org/${p.orcid}`, icon: 'orcid' }] : []),
  ...(p.linkedin ? [{ label: 'LinkedIn', href: p.linkedin, icon: 'in' }] : []),
  ...(p.website ? [{ label: 'Website', href: p.website, icon: 'web' }] : []),
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: p.name,
  honorificPrefix: p.honorific || undefined,
  jobTitle: p.role || undefined,
  affiliation: p.institution ? { '@type': 'Organization', name: p.institution } : undefined,
  sameAs: links.map((l) => l.href),
  memberOf: { '@type': 'Organization', name: 'ELIXIR-UK' },
};
---
<BaseLayout title={`${p.honorific ? p.honorific + ' ' : ''}${p.name}`} description={[p.role, p.institution].filter(Boolean).join(', ')} {jsonLd}>
  <div class="banner pf-band"><div class="container"><Crumbs dark items={[{ label: 'People', href: '/people/' }, { label: p.name }]} /></div></div>
  <div class="container pf">
    <aside class="pf-side">
      <div class="pf-photo"><Avatar src={p.photo} name={p.name} size={220} ring="var(--white)" eager /></div>
      {p.honorific && <p class="pf-hon">{p.honorific}</p>}
      <h1 class="pf-name">{p.name}<span class="stop">.</span></h1>
      {p.role && <p class="pf-role">{p.role}</p>}
      {org && (
        <a class="pf-org" href={url(`/members/${org.slug}/`)}>
          {org.logo && <span class="pf-org__logo"><RemoteImage src={org.logo} width={200} alt="" /></span>}
          <span>{org.name}</span>
        </a>
      )}
      {!org && p.institution && <p class="pf-org pf-org--plain">{p.institution}</p>}
      {links.length > 0 && (
        <ul class="pf-links">{links.map((l) => <li><a href={l.href} rel="noopener"><span class="pf-ico" aria-hidden="true">{l.icon === 'orcid' ? 'iD' : l.icon === 'in' ? 'in' : '↗'}</span>{l.label}</a></li>)}</ul>
      )}
      {(p.governance.length > 0 || p.tags.length > 0) && (
        <div class="pf-block">
          <p class="pf-sub">In ELIXIR-UK</p>
          <ul class="pf-pills">{[...p.governance, ...p.tags].map((g) => <li>{g}</li>)}</ul>
        </div>
      )}
      {leads.length > 0 && (
        <div class="pf-block">
          <p class="pf-sub">Leads</p>
          <ul class="pf-leads">{leads.map((a) => (
            <li><a href={url(`/activities/${a.slug}/`)}>
              <span class="icon-disc">{a.logo ? <img src={localAsset(a.logo)} alt="" /> : <b>{a.name[0]}</b>}</span>{a.name}
            </a></li>
          ))}</ul>
        </div>
      )}
    </aside>
    <div class="pf-main">
      <SmartTabs kind="people" slug={entry.id} hasBio={Boolean(p.bio)} bioLabel="Biography" skip={['members']}>
        <div class="prose pf-bio"><p>{p.bio}</p></div>
      </SmartTabs>
    </div>
  </div>
</BaseLayout>

<style>
  .pf-band { padding-block: var(--s5) 120px; }
  .pf-band .crumb { margin: 0; }
  .pf { display: grid; grid-template-columns: 300px minmax(0, 1fr); gap: clamp(32px, 5vw, 80px); align-items: start; margin-top: -110px; position: relative; }
  .pf-side { position: sticky; top: 100px; padding: var(--s6); border-radius: var(--radius-lg); background: var(--white); box-shadow: var(--shadow); }
  .pf-photo { display: flex; justify-content: center; margin-bottom: var(--s5); }
  .pf-photo :global(.avatar) { width: 200px !important; }
  .pf-hon { margin: 0; font-size: var(--fs-sm); font-weight: 700; letter-spacing: 0;  color: var(--muted); }
  .pf-name { margin: 2px 0 var(--s2); font-size: clamp(1.8rem, 1.4rem + 1.2vw, 2.3rem); font-weight: 900; letter-spacing: -0.02em; line-height: 1.05; }
  .pf-role { margin: 0 0 var(--s4); font-size: var(--fs-sm); line-height: 1.45; }
  .pf-org { display: flex; align-items: center; gap: var(--s3); padding: var(--s3); border-radius: 8px; background: var(--grey-light); color: var(--navy); font-weight: 700; font-size: var(--fs-sm); line-height: 1.3; }
  .pf-org:hover { background: #e7eef3; color: var(--orange-text); }
  .pf-org__logo { flex: none; display: flex; align-items: center; justify-content: center; width: 72px; height: 44px; padding: 4px; border-radius: 4px; background: var(--white); }
  .pf-org__logo :global(img) { max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; }
  .pf-links { list-style: none; margin: var(--s4) 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s2); }
  .pf-links a { display: inline-flex; align-items: center; gap: 6px; min-height: 36px; padding: 0 var(--s3); border: 1px solid var(--border); border-radius: 999px; font-size: var(--fs-sm); font-weight: 700; color: var(--navy); }
  .pf-links a:hover { border-color: var(--navy); }
  .pf-ico { display: grid; place-items: center; width: 20px; height: 20px; border-radius: 50%; background: var(--navy); color: var(--white); font-size: 10px; font-weight: 900; }
  .pf-block { margin-top: var(--s5); padding-top: var(--s4); border-top: 1px solid var(--border); }
  .pf-sub { margin: 0 0 var(--s3); font-size: var(--fs-sm); font-weight: 700; letter-spacing: 0;  color: var(--orange-text); }
  .pf-pills { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .pf-pills li { font-size: var(--fs-xs); font-weight: 700; padding: 3px 9px; border-radius: 3px; background: var(--navy); color: var(--white); }
  .pf-leads { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s2); }
  .pf-leads a { display: flex; align-items: center; gap: var(--s3); font-weight: 700; font-size: var(--fs-sm); color: var(--navy); }
  .pf-leads .icon-disc { width: 40px; background: var(--grey-light); border: 0; }
  .pf-main { padding-top: 130px; min-width: 0; }
  .pf-h { font-size: var(--fs-h3); margin: 0 0 var(--s4); }
  .pf-bio { font-size: 1.1rem; }
  .pf-empty { color: var(--muted); }
  @media (max-width: 860px) {
    .pf { grid-template-columns: 1fr; margin-top: -100px; }
    .pf-side { position: static; }
    .pf-main { padding-top: 0; }
  }
</style>
