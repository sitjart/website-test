---
import { getCollection } from 'astro:content';
import ProfileLayout from '../../layouts/ProfileLayout.astro';
import ProfileSide from '../../components/ProfileSide.astro';
import SmartTabs from '../../components/SmartTabs.astro';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const people = await getCollection('people');
  return people.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const p = entry.data;

const links = [
  ...(p.orcid ? [{ label: 'ORCID', href: p.orcid }] : []),
  ...(p.website ? [{ label: 'Website', href: p.website }] : []),
  ...(p.linkedin ? [{ label: 'LinkedIn', href: p.linkedin }] : []),
];

// Bioschemas / schema.org Person markup: makes each profile part of the public knowledge graph
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: p.name,
  jobTitle: p.role,
  affiliation: { '@type': 'Organization', name: p.institution },
  ...(p.orcid ? { identifier: p.orcid, sameAs: [p.orcid] } : {}),
  memberOf: { '@type': 'Organization', name: 'ELIXIR-UK' },
};
---
<ProfileLayout title={p.name} description={`${p.role}, ${p.institution}`} {jsonLd}>
  <Fragment slot="side">
    <ProfileSide name={p.name} subtitle={`${p.role}${p.institution ? `, ${p.institution}` : ''}`} image={p.photo} round
      pills={{ heading: 'Governance roles', items: p.governance }} {links} />
    <a class="side-back" href={url('/people/')}>← All people</a>
  </Fragment>
  <SmartTabs kind="people" slug={entry.id} hasBio={Boolean(p.bio)}>
    <div class="prose"><p>{p.bio}</p></div>
  </SmartTabs>
</ProfileLayout>

<style>
  .side-back { font-size: 14px; align-self: flex-start; }
</style>
