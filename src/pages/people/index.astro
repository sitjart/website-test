---
// People: current members only (alumni and collaborators keep their profiles but are not listed),
// filterable by governance group and by name, role or organisation.
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Avatar from '../../components/Avatar.astro';
import { isCurrent } from '../../lib/people';
import { slugify } from '../../lib/baserow';
import { url } from '../../lib/url';

const people = (await getCollection('people')).filter(isCurrent).sort((a, b) => a.data.name.split(' ').at(-1)!.localeCompare(b.data.name.split(' ').at(-1)!, 'en-GB'));
const ORDER = ['Heads of Node', 'Coordination office', 'Management Committee', 'Steering Committee', 'Scientific Development Group', 'Scientific and Industry Advisory Board'];
const groups = ORDER.map((g) => ({ g, n: people.filter((p) => [...p.data.governance, ...p.data.tags].includes(g)).length })).filter((x) => x.n);
---
<BaseLayout title="People" description="The people behind ELIXIR-UK.">
  <PageHeader title="People" intro="The people behind ELIXIR-UK. Profiles appear only with consent." illustration="illustration-isometrics-team-rowing.svg" />
  <section class="section">
    <div class="container">
      <div class="tools">
        <div class="search">
          <label for="q" class="visually-hidden">Search people</label>
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M15.5 15.5 21 21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          <input id="q" type="search" placeholder="Search by name, role or organisation" autocomplete="off" />
        </div>
        <div class="filters" role="group" aria-label="Filter by role in ELIXIR-UK">
          <button type="button" class="chip is-active" data-g="" aria-pressed="true">Everyone</button>
          {groups.map(({ g, n }) => <button type="button" class="chip" data-g={slugify(g)} aria-pressed="false">{g} <span>{n}</span></button>)}
        </div>
        <p class="status" aria-live="polite"></p>
      </div>
      <ul class="people-grid">
        {people.map((p) => (
          <li data-q={`${p.data.name} ${p.data.role} ${p.data.institution}`.toLowerCase()} data-g={[...p.data.governance, ...p.data.tags].map(slugify).join(' ')}>
            <a class="person" href={url(`/people/${p.id}/`)}>
              <Avatar src={p.data.photo} name={p.data.name} size={136} />
              
              <span class="person__name">{p.data.name}</span>
              {p.data.role && <span class="person__role">{p.data.role}</span>}
              {p.data.institution && <span class="person__inst">{p.data.institution}</span>}
              {p.data.governance.length > 0 && <span class="person__gov">{p.data.governance.join(' · ')}</span>}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<script>
  const q = document.querySelector<HTMLInputElement>('#q')!;
  const chips = document.querySelectorAll<HTMLButtonElement>('[data-g]:is(button)');
  const items = document.querySelectorAll<HTMLElement>('.people-grid li');
  const status = document.querySelector<HTMLElement>('.status')!;
  let group = '';
  const apply = () => {
    const v = q.value.trim().toLowerCase();
    let n = 0;
    items.forEach((li) => {
      const ok = (!v || (li.dataset.q ?? '').includes(v)) && (!group || (li.dataset.g ?? '').split(' ').includes(group));
      li.hidden = !ok; if (ok) n++;
    });
    status.textContent = v || group ? `${n} ${n === 1 ? 'person' : 'people'}` : '';
  };
  q.addEventListener('input', apply);
  chips.forEach((c) => c.addEventListener('click', () => {
    group = c.dataset.g ?? '';
    chips.forEach((x) => { const on = x === c; x.classList.toggle('is-active', on); x.setAttribute('aria-pressed', String(on)); });
    history.replaceState(null, '', group ? `#${group}` : location.pathname);
    apply();
  }));
  const start = location.hash.slice(1);
  const hit = [...chips].find((c) => c.dataset.g === start);
  if (hit) hit.click();
</script>

<style>
  .tools { margin-bottom: var(--s7); }
  .search { position: relative; max-width: 560px; margin-bottom: var(--s4); }
  .search svg { position: absolute; left: 16px; top: 14px; width: 22px; height: 22px; color: var(--muted); }
  .search input { width: 100%; min-height: 52px; padding: 0 var(--s4) 0 48px; font: inherit; border: 1px solid #cbd6de; border-radius: var(--radius); background: var(--white); color: var(--text); }
  .search input:focus-visible { outline: 3px solid var(--orange); outline-offset: 1px; border-color: var(--navy); }
  .filters { display: flex; flex-wrap: wrap; gap: var(--s2); }
  .chip { font: inherit; font-size: var(--fs-sm); min-height: 40px; padding: 0 var(--s4); border: 1px solid #cbd6de; border-radius: 999px; background: var(--white); color: var(--navy); cursor: pointer; }
  .chip span { color: var(--muted); font-size: var(--fs-xs); }
  .chip.is-active { background: var(--navy); border-color: var(--navy); color: var(--white); }
  .chip.is-active span { color: #9fbcd0; }
  .status { min-height: 1.4em; margin: var(--s3) 0 0; font-size: var(--fs-sm); color: var(--muted); }
  .people-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 180px), 1fr)); gap: var(--s7) var(--s5); }
  .people-grid li { display: flex; }
  .person { flex: 1; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 2px; color: var(--text); }
  .person:hover { color: var(--text); }
  .person :global(.avatar) { margin-bottom: var(--s4); transition: transform 0.3s var(--ease); }
  .person :global(.avatar > img), .person :global(.avatar__fill) { transition: box-shadow 0.3s var(--ease); }
  .person:hover :global(.avatar) { transform: translateY(-4px); }
  .person:hover :global(.avatar > img), .person:hover :global(.avatar__fill) { box-shadow: 0 0 0 4px var(--white), 0 0 0 6px var(--orange); }
  .person__hon { display: block; min-height: 1.4em; line-height: 1.4; font-size: var(--fs-xs); color: var(--muted); }
  .person__name { font-size: 1.1rem; font-weight: 700; line-height: 1.25; color: var(--navy); }
  .person:hover .person__name { color: var(--orange-text); }
  .person__role { font-size: var(--fs-sm); line-height: 1.4; margin-top: 2px; }
  .person__inst { font-size: var(--fs-xs); color: var(--muted); }
  .person__gov { margin-top: var(--s2); font-size: var(--fs-xs); font-weight: 700; color: var(--orange-text); }
</style>
