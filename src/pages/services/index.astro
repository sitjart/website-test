---
// Services: grouped by status, with the labels explained and the call for services alongside.
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import RemoteImage from '../../components/RemoteImage.astro';
import { DIRECTORY, type DirectoryRecord } from '../../lib/graph';
import { firstSentence } from '../../lib/format';
import labels from '../../data/service-labels.json';
import { url } from '../../lib/url';
import { tagSlug } from '../../lib/graph';

const all = DIRECTORY.services.records;
const groups = labels.statuses.map((s) => ({ ...s, items: all.filter((r) => r.status === s.tag).sort((a, b) => a.name.localeCompare(b.name, 'en-GB')) })).filter((g) => g.items.length);
const rec = (r: DirectoryRecord) => labels.recognitions.filter((x) => r.tags.includes(x.tag));
const selected = groups.find((g) => g.tag === 'Selected')?.items.length ?? 0;
---
<BaseLayout title="Services" description="Open-access services for the life sciences community, endorsed by ELIXIR-UK.">
  <PageHeader title="Services" intro="Open-access services for the life sciences community, endorsed by ELIXIR-UK." illustration="illustration-isometrics-mechanisms-working.svg" count={{ n: selected, label: 'selected services' }} />

  <section class="section about-svc" id="about-services" aria-labelledby="about-h">
    <div class="container about-svc__grid">
      <div>
        <h2 class="section-title" id="about-h">Supporting open-access services for the life sciences community<span class="stop">.</span></h2>
        <p class="lead">Services selected by the UK Node amplify their reach and improve their opportunities for long-term sustainability.</p>
        <p>ELIXIR-UK services benefit from exposure to a wide range of potential users and collaborators across Europe and globally.</p>
        <p>Although Node Service status does not confer additional funding, it indicates the value placed on the service by ELIXIR. Furthermore, those offering Node Services can apply for ELIXIR Europe funding through their projects called Implementation Studies and for UK Node funding for participation in ELIXIR.</p>
        <p class="about-svc__key">The most significant benefit is the raised profile throughout ELIXIR.</p>
      </div>
      <div class="selected-how">
        <h3>How do services get selected?</h3>
        <ol>
          <li>An annual, open and transparent process to conform to a set of criteria designed to ensure high service quality and match UK priorities as identified by its funders.</li>
          <li>Project commitments made to ELIXIR.</li>
        </ol>
        <a class="more-link" href={url('/call-for-services/')}>Selection criteria, process and benefits</a>
      </div>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container svc">
      <div class="svc__main">
        <div class="filters" role="group" aria-label="Filter by recognition">
          <button type="button" class="chip is-active" data-label="" aria-pressed="true">All services <span>{all.length}</span></button>
          {labels.recognitions.map((x) => <button type="button" class="chip" data-label={tagSlug(x.tag)} aria-pressed="false">{x.short} <span>{all.filter((r) => r.tags.includes(x.tag)).length}</span></button>)}
        </div>
        {labels.recognitions.map((x) => (
          <div class="label-explain" data-explain={tagSlug(x.tag)} hidden aria-live="polite">
            <p class="label-explain__h">{x.short}</p>
            <p>{x.text}</p>
          </div>
        ))}
        {groups.map((g) => (
          <section class="sgroup" id={g.tag.toLowerCase()} aria-labelledby={`h-${g.tag}`}>
            <header class="sgroup__head">
              <h2 id={`h-${g.tag}`}>{g.title} <span>{g.items.length}</span></h2>
              <p>{g.text}{g.draft && <> <span class="draft">Draft wording</span></>}</p>
            </header>
            <ul class="scards">
              {g.items.map((r) => (
                <li data-labels={r.tags.map(tagSlug).join(' ')}><a class="card scard" href={url(`/services/${r.slug}/`)}>
                  <span class="scard__logo">{r.logo ? <RemoteImage src={r.logo} width={360} alt="" /> : <b>{r.name}</b>}</span>
                  <span class="scard__body">
                    <span class="card__title">{r.name}</span>
                    {(r.excerpt || r.summary) && <span class="scard__sum">{r.excerpt || firstSentence(r.summary, 130)}</span>}
                    {rec(r).length > 0 && <span class="scard__badges">{rec(r).map((x) => <span class="badge" title={x.text}>{x.short}</span>)}</span>}
                  </span>
                </a></li>
              ))}
            </ul>
          </section>
        ))}
      </div>

      <aside class="svc__side">
        <div class="cfs">
          <p class="eyebrow-sm">Call for services</p>
          <p class="cfs__title">Do you have a service that could help the life science community deal with current data challenges?</p>
          <p>Visit our call for services page to learn more about the selection criteria, process and benefits.</p>
          <a class="btn" href={url('/call-for-services/')}>Become an endorsed service</a>
        </div>
        <div class="explain">
          <p class="explain__h">What the labels mean</p>
          {labels.statuses.map((s) => (
            <details class="acc"><summary>{s.title}</summary><div class="acc__body"><p>{s.text}</p>{s.draft && <span class="draft">Draft wording</span>}</div></details>
          ))}
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<script>
  // Recognition filter: shows only services with that label, and explains what the label means
  const chips = document.querySelectorAll<HTMLButtonElement>('[data-label]');
  const items = document.querySelectorAll<HTMLElement>('.scards li');
  const apply = (label: string) => {
    items.forEach((li) => (li.hidden = !!label && !(li.dataset.labels ?? '').split(' ').includes(label)));
    document.querySelectorAll<HTMLElement>('.sgroup').forEach((g) => (g.hidden = !g.querySelector('li:not([hidden])')));
    document.querySelectorAll<HTMLElement>('[data-explain]').forEach((e) => (e.hidden = e.dataset.explain !== label));
    chips.forEach((c) => { const on = c.dataset.label === label; c.classList.toggle('is-active', on); c.setAttribute('aria-pressed', String(on)); });
  };
  chips.forEach((c) => c.addEventListener('click', () => { const l = c.dataset.label ?? ''; history.replaceState(null, '', l ? `#${l}` : location.pathname); apply(l); }));
  const start = decodeURIComponent(location.hash.slice(1));
  if ([...chips].some((c) => c.dataset.label === start)) apply(start);
</script>

<style>
  .filters { display: flex; flex-wrap: wrap; gap: var(--s2); margin-bottom: var(--s5); }
  .chip { font: inherit; font-size: var(--fs-sm); min-height: 40px; padding: 0 var(--s4); border: 1px solid var(--border); border-radius: 999px; background: var(--white); color: var(--navy); cursor: pointer; }
  .chip span { color: var(--muted); font-size: var(--fs-xs); }
  .chip:hover { border-color: var(--navy); }
  .chip.is-active { background: var(--navy); border-color: var(--navy); color: var(--white); }
  .chip.is-active span { color: #9fbcd0; }
  .label-explain { margin-bottom: var(--s6); padding: var(--s5); border-left: 4px solid var(--orange); border-radius: 0 var(--radius-lg) var(--radius-lg) 0; background: #fff6ef; }
  .label-explain__h { margin: 0 0 var(--s2); font-weight: 700; font-size: 1.15rem; color: var(--navy); }
  .label-explain p:last-child { margin: 0; max-width: 62ch; }
  .about-svc__grid { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: clamp(32px, 5vw, 80px); align-items: start; }
  .about-svc .section-title { font-size: clamp(1.9rem, 1.3rem + 2vw, 2.8rem); margin-bottom: var(--s5); }
  .about-svc__key { font-weight: 700; color: var(--navy); }
  .selected-how { padding: var(--s6); border-radius: var(--radius-lg); background: var(--grey-light); border-left: 4px solid var(--orange); }
  .selected-how h3 { margin: 0 0 var(--s4); }
  .selected-how ol { margin: 0 0 var(--s5); padding-left: 1.3em; display: grid; gap: var(--s3); }
  .selected-how li::marker { color: var(--orange-text); font-weight: 900; }
  @media (max-width: 900px) { .about-svc__grid { grid-template-columns: 1fr; } }
  .svc { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: clamp(32px, 4vw, 64px); align-items: start; }
  .jump { display: flex; flex-wrap: wrap; gap: var(--s2); margin-bottom: var(--s7); }
  .jump a { display: inline-flex; align-items: center; gap: 6px; min-height: 40px; padding: 0 var(--s4); border-radius: 999px; background: var(--grey-light); color: var(--navy); font-size: var(--fs-sm); font-weight: 700; }
  .jump a span { color: var(--orange-text); }
  .jump a:hover { background: var(--navy); color: var(--white); }
  .sgroup { scroll-margin-top: 100px; }
  .sgroup + .sgroup { margin-top: var(--s8); }
  .sgroup__head { margin-bottom: var(--s5); padding-bottom: var(--s4); border-bottom: 1px solid var(--border); }
  .sgroup__head h2 { font-size: var(--fs-h3); margin: 0 0 var(--s2); }
  .sgroup__head h2 span { color: var(--orange-text); font-weight: 400; }
  .sgroup__head p { margin: 0; color: var(--muted); font-size: var(--fs-sm); max-width: 60ch; }
  .scards { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr)); gap: var(--s4); }
  .scards li { display: flex; }
  .scard { flex: 1; padding: 0; overflow: hidden; }
  .scard__logo { display: flex; align-items: center; justify-content: center; height: 136px; padding: var(--s4) var(--s5); border-bottom: 1px solid var(--border); }
  .scard__logo :global(img) { max-width: 100%; max-height: 100px; width: auto; height: auto; object-fit: contain; }
  .scard__logo b { color: var(--navy); font-size: 1.2rem; text-align: center; }
  .scard__body { display: flex; flex-direction: column; gap: var(--s2); padding: var(--s4) var(--s5) var(--s5); flex: 1; }
  .scard__sum { font-size: var(--fs-sm); line-height: 1.5; }
  .scard__badges { display: flex; flex-wrap: wrap; gap: 6px; margin-top: auto; padding-top: var(--s2); }
  .badge { font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 3px; background: #e3f1f7; color: var(--blue-dark); }
  .svc__side { position: sticky; top: 100px; display: flex; flex-direction: column; gap: var(--s5); }
  .cfs { padding: var(--s6); border-radius: var(--radius-lg); background: var(--ink); color: var(--on-dark); }
  .cfs .eyebrow-sm { color: var(--orange-soft); }
  .cfs__title { font-size: 1.25rem; font-weight: 700; line-height: 1.3; color: var(--white); }
  .cfs p { font-size: var(--fs-sm); }
  .explain__h { margin: 0 0 var(--s2); font-size: var(--fs-sm); font-weight: 700; letter-spacing: 0;  color: var(--navy); }
  .explain .acc > summary { font-size: var(--fs-sm); padding-block: var(--s3); }
  .explain .acc__body { font-size: var(--fs-sm); }
  .explain { border-top: 1px solid var(--border); }
  @media (max-width: 1000px) { .svc { grid-template-columns: 1fr; } .svc__side { position: static; } }
</style>
