---
import DirectoryRecord from '../../components/DirectoryRecord.astro';
import { DIRECTORY } from '../../lib/graph';

export function getStaticPaths() {
  return DIRECTORY['services'].records.map((record) => ({ params: { slug: record.slug }, props: { record } }));
}
const { record } = Astro.props;
---
<DirectoryRecord kind="services" {record} />
