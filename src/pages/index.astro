---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import UkMap from '../components/UkMap.astro';
import RemoteImage from '../components/RemoteImage.astro';
import home from '../data/home.json';
import { DIRECTORY, linksFor } from '../lib/graph';
import { longDate, todayUK } from '../lib/format';
import { url } from '../lib/url';

const memberCount = DIRECTORY.members.records.length;
const services = DIRECTORY.services.records.filter((s) => s.status === 'Selected');

const news = (await getCollection('news')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 3);
const today = todayUK();
const upcoming = (await getCollection('events'))
  .filter((e) => (e.data.end ?? e.data.start) >= today)
  .sort((a, b) => a.data.start.getTime() - b.data.start.getTime())
  .slice(0, 3);
const allNews = await getCollection('news');

// Thematic areas: picture = the area's own image, else the newest linked story's image
const areas = await Promise.all(
  home.thematic.map(async (slug) => {
    const r = DIRECTORY.area.records.find((a) => a.slug === slug)!;
    const links = await linksFor('area', slug);
    const story = links.news?.map((n) => allNews.find((x) => x.id === n.slug)).find((n) => n?.data.image);
    const counts = Object.entries(links).filter(([k]) => k !== 'news').map(([k, v]) => `${v!.length} ${k}`).slice(0, 2).join(' · ');
    return { ...r, image: r.logo || story?.data.image, counts };
  }),
);
const day = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', timeZone: 'UTC' });
const month = (d: Date) => d.toLocaleDateString('en-GB', { month: 'long', timeZone: 'UTC' });

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'ELIXIR-UK',
  url: 'https://elixiruknode.org',
  parentOrganization: { '@type': 'Organization', name: 'ELIXIR', url: 'https://elixir-europe.org' },
};
---
<BaseLayout description={home.intro} {jsonLd}>
  <section class="banner hero">
    <div class="container hero__grid">
      <div>
        <h1 class="display hero__title">ELIXIR-UK</h1>
        <p class="hero__intro">{home.intro}</p>
        <div class="hero__actions">
          <a class="btn" href={url('/join-in/')}>Get involved</a>
          <a class="btn btn--ghost" href={home.video}>Watch our story ▸</a>
        </div>
      </div>
      <figure class="hero__map">
        <UkMap />
        <figcaption><span class="display">{memberCount}</span><span>member organisations<br />across the UK</span></figcaption>
      </figure>
    </div>
  </section>

  <section class="container mission" aria-label="Our mission">
    {home.mission.map((m, i) => (
      <a class:list={['mission__tile', 'lift', { 'is-highlight': m.highlight }]} href={url(m.href)} data-reveal="fade-up" style={`--delay:${i * 80}ms`}>
        <span class="eyebrow-sm">Our mission</span>
        <span class="mission__title">{m.title}<span class="stop">.</span></span>
        <span class="mission__text">{m.text}</span>
      </a>
    ))}
  </section>

  <section class="section section--grey">
    <div class="container">
      <div class="head-row">
        <h2 class="section-title">What’s new<span class="stop">.</span></h2>
        <a href={url('/news/')}>All news &amp; stories →</a>
      </div>
      <div class="news-tiles">
        {news.map((n, i) => i === 0 ? (
          <a class="tile news-tile news-tile--photo" href={url(`/news/${n.id}/`)}>
            {n.data.image && <RemoteImage class="ph-img" src={n.data.image} width={900} />}
            <span class="ph-slide"></span>
            <span class="scrim">
              <span class="tag">{n.data.category} · {longDate(n.data.date)}</span>
              <span class="news-tile__title news-tile__title--big">{n.data.title}</span>
            </span>
          </a>
        ) : (
          <a class:list={['news-tile', 'lift', i === 1 ? 'news-tile--navy' : 'news-tile--blue']} href={url(`/news/${n.id}/`)}>
            <span class="tag" style={i === 2 ? 'background: var(--navy)' : ''}>{n.data.category} · {longDate(n.data.date)}</span>
            <span class="news-tile__title">{n.data.title}</span>
            <span class="news-tile__more">Read →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="container split">
      <div>
        <h2 class="section-title">Thematic areas<span class="stop">.</span></h2>
        <p>Each area brings together the communities, services, projects, people and news working on it.</p>
        <a href={url('/area/')}>All thematic areas →</a>
      </div>
      <div class="area-tiles">
        {areas.map((a) => (
          <a class="tile area-tile" href={url(`/area/${a.slug}/`)}>
            {a.image ? <RemoteImage class="ph-img" src={a.image} width={500} /> : <span class="ph-img" style="background:#5b7f9a"></span>}
            <span class="ph-slide"></span>
            <span class="scrim"><span class="area-tile__title">{a.name}</span>{a.counts && <span class="area-tile__meta">{a.counts}</span>}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {upcoming.length > 0 && (
    <section class="banner coming">
      <svg class="coming__mark" aria-hidden="true" viewBox="56 0 120 126"><path fill="#f47d21" d="M160.79,0C155.54,0,151.29,4.25,151.29,9.5c0,1.57.39,3.11,1.1,4.5-.9.5-3.1,1.6-6.2,3.2-1.63-3.56-5.84-5.13-9.4-3.5-3.56,1.63-5.13,5.84-3.5,9.4h0c.1.3.3.5.4.8-1.6.9-3.2,1.8-4.9,2.7-1.46-2.7-4.83-3.71-7.53-2.25-2.7,1.46-3.71,4.83-2.25,7.53.06.11.12.21.18.32-1.7,1-3.5,2.1-5.3,3.2-1.65-1.47-4.18-1.31-5.65.34-.02.02-.04.04-.05.06-.64.76-.99,1.71-1,2.7,0,.4.1.7.1,1-6.72,4.29-13.17,9-19.3,14.1-6.4-14.3-15.9-30.1-29-42.9h0c-1.5-1.5-2.8-.8-1,1l.1.1c11.2,12,19.9,29.4,25.9,45.3-22.7,19.4-47.7,56.9-20.29,68.7,4,1.7,5.8-1.6,4.1-2.6-.3-.2-12.5-6.8-4.8-27h19.5c1.05,0,1.9-.85,1.9-1.9s-.85-1.9-1.9-1.9h-17.91c1.2-2.5,2.5-4.9,3.9-7.2h14c1.03-.1,1.81-.97,1.8-2-.07-.96-.84-1.73-1.8-1.8h-11.6c1.5-2.2,3.1-4.5,4.9-6.8h6.7c1.03-.1,1.81-.97,1.8-2-.07-.96-.84-1.73-1.8-1.8h-3.7c2.1-2.6,4.5-5.3,7.1-8.1l.1-.1c5.1,14.9,7.6,27.6,7.1,31.9-.11,1.54-1.02,2.9-2.39,3.6-1,.5-1.4,1.8.2,2.2,4.8,1.4,7.8-3.3,8.3-7.2s-2.1-18-9-34.8c6.03-5.89,12.48-11.33,19.29-16.3.59.39,1.29.6,2,.6,2.23,0,4.05-1.77,4.1-4,.02-.27-.02-.54-.1-.8,1.8-1.3,3.6-2.5,5.4-3.7,2.38,1.93,5.87,1.57,7.8-.8,1.09-1.38,1.5-3.18,1.1-4.9,1.8-1.1,3.5-2.2,5.2-3.1,2.53,2.93,6.95,3.25,9.87.72,2.18-1.88,2.98-4.91,2.03-7.62,3-1.7,5.2-2.9,6.3-3.5,2.92,4.36,8.82,5.52,13.18,2.6,4.36-2.92,5.52-8.82,2.6-13.18-.03-.04-.05-.08-.08-.12C167.02,1.58,164,.01,160.79,0Z"/></svg>
      <div class="container split">
        <div>
          <h2 class="section-title" style="color:#fff">Coming up<span class="stop">.</span></h2>
          <p>Community Calls, workshops and the All Hands meeting.</p>
          <a href={url('/events/')} style="color:#ffb37a">All events →</a>
        </div>
        <ol class="coming__list">
          {upcoming.map((e) => (
            <li>
              <a href={url(`/events/${e.id}/`)}>
                <span class="coming__date"><span class="display">{day(e.data.start)}</span><span>{month(e.data.start)}</span></span>
                <span class="coming__title">{e.data.title}</span>
                <span class="tag" style={e.data.type === 'Community Call' ? '' : 'background: var(--blue)'}>{e.data.type}</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  <section class="services-band">
    <div class="container split split--wide">
      <div>
        <p class="eyebrow-sm" style="color:#ffb37a">Open-access services</p>
        <p class="display services-band__num">{services.length}<span class="stop">.</span></p>
        <p class="services-band__text">services endorsed by ELIXIR-UK for the life sciences community.</p>
        <a class="btn" href={url('/services/')}>Discover our services</a>
      </div>
      <div class="services-band__logos" aria-label="Endorsed services">
        {services.filter((s) => s.logo).slice(0, 15).map((s) => (
          <a href={url(`/services/${s.slug}/`)} title={s.name} class="lift"><RemoteImage src={s.logo} width={160} alt={s.name} /></a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { padding: 40px 0 180px; }
  .hero__grid { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); gap: 48px; align-items: center; }
  .hero__title { font-size: clamp(3.5rem, 8vw, 6.5rem); margin: 0; }
  .hero__intro { margin: 32px 0 36px; max-width: 34rem; font-size: 1.3rem; font-weight: 300; color: #c3d3de; }
  .hero__actions { display: flex; gap: 12px; flex-wrap: wrap; }
  .hero__map { margin: 0; display: flex; flex-direction: column; align-items: center; gap: 14px; }
  .hero__map :global(svg) { max-width: 340px; }
  .hero__map figcaption { display: flex; align-items: baseline; gap: 12px; color: #c3d3de; font-size: 15px; }
  .hero__map figcaption .display { font-size: 56px; color: var(--white); }

  .mission { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; margin-top: -120px; position: relative; z-index: 2; padding-bottom: 96px; }
  .mission__tile { display: flex; flex-direction: column; gap: 8px; padding: 26px 28px; border-radius: 10px; background: var(--white); color: var(--text); box-shadow: 0 32px 48px rgb(0 0 0 / 0.22); }
  .mission__tile:hover { color: var(--text); }
  .mission__title { font-size: 21px; font-weight: 700; line-height: 1.2; color: var(--navy); }
  .mission__text { font-size: 15px; line-height: 1.5; }
  .mission__tile.is-highlight { background: var(--orange); color: var(--white); }
  .mission__tile.is-highlight .eyebrow-sm, .mission__tile.is-highlight .mission__title { color: var(--white); }
  .mission__tile.is-highlight .stop { color: var(--navy); }

  .head-row { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; margin-bottom: 40px; flex-wrap: wrap; }
  .head-row a { font-weight: 700; }
  .news-tiles { display: grid; grid-template-columns: 2fr 1fr 1fr; grid-auto-rows: 440px; gap: 16px; }
  .news-tile { display: flex; flex-direction: column; justify-content: space-between; gap: 16px; padding: 32px; border-radius: 10px; color: var(--white); }
  .news-tile:hover { color: var(--white); }
  .news-tile--photo { padding: 0; background: var(--blue); }
  .news-tile--navy { background: var(--navy); }
  .news-tile--blue { background: var(--blue); }
  .news-tile .tag { align-self: flex-start; }
  .news-tile__title { font-size: 23px; font-weight: 700; line-height: 1.22; }
  .news-tile__title--big { font-size: 30px; }
  .news-tile__more { font-weight: 700; color: #ffb37a; }
  .news-tile--blue .news-tile__more { color: var(--white); }
  .news-tile--photo .scrim { padding: 32px; gap: 12px; }

  .split { display: grid; grid-template-columns: 340px minmax(0, 1fr); gap: 64px; align-items: start; }
  .split--wide { grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); align-items: center; }
  .split p { margin: 16px 0 24px; }
  .split a { font-weight: 700; }
  .area-tiles { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .area-tile { aspect-ratio: 3 / 4; border-radius: 10px; background: var(--navy); }
  .area-tile__title { font-size: 23px; font-weight: 700; line-height: 1.15; }
  .area-tile__meta { font-size: 14px; }

  .coming { padding-block: 112px; }
  .coming__mark { position: absolute; right: -120px; top: -40px; width: 560px; opacity: 0.16; }
  .coming__list { list-style: none; margin: 0; padding: 0; border-top: 1px solid #1f4762; }
  .coming__list a { display: grid; grid-template-columns: 110px minmax(0, 1fr) auto; gap: 28px; align-items: center; padding: 26px 0; border-bottom: 1px solid #1f4762; color: var(--white); }
  .coming__date { line-height: 1; }
  .coming__date .display { display: block; font-size: 56px; }
  .coming__date span:last-child { font-size: 15px; color: #c3d3de; }
  .coming__title { font-size: 23px; font-weight: 700; line-height: 1.3; }
  .coming__list a:hover .coming__title { color: #ffb37a; }

  .services-band { background: var(--navy); color: #c3d3de; padding-block: 96px; }
  .services-band__num { font-size: 120px; color: var(--white); margin: 0; line-height: 0.9; }
  .services-band__text { font-size: 21px; }
  .services-band__logos { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 14px; }
  .services-band__logos a { display: grid; place-items: center; aspect-ratio: 1; padding: 14px; border-radius: 10px; background: var(--white); }
  .services-band__logos :global(img) { max-width: 100%; max-height: 100%; object-fit: contain; }

  @media (max-width: 960px) {
    .hero__grid, .split, .split--wide { grid-template-columns: 1fr; }
    .mission { grid-template-columns: 1fr 1fr; }
    .news-tiles { grid-template-columns: 1fr; grid-auto-rows: 320px; }
    .area-tiles { grid-template-columns: 1fr 1fr; }
    .coming__list a { grid-template-columns: 80px minmax(0, 1fr); }
    .coming__list .tag { display: none; }
    .services-band__logos { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 560px) { .mission, .area-tiles { grid-template-columns: 1fr; } }
</style>
