---
// Home – written for members and funders first: who we are, what the Node delivers, the evidence.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import UkMap from '../components/UkMap.astro';
import HeroShapes from '../components/HeroShapes.astro';
import RemoteImage from '../components/RemoteImage.astro';
import GrowthChart from '../components/charts/GrowthChart.astro';
import BarChart from '../components/charts/BarChart.astro';
import home from '../data/home.json';
import { DIRECTORY, linksFor } from '../lib/graph';
import { nodeStats } from '../lib/stats';
import { asset, localAsset } from '../lib/assets';
import { longDate, todayUK, firstSentence } from '../lib/format';
import { url } from '../lib/url';

const stats = await nodeStats();
const services = DIRECTORY.services.records.filter((s) => s.status === 'Selected');
const allNews = (await getCollection('news')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const news = allNews.slice(0, 3);
const today = todayUK();
const upcoming = (await getCollection('events'))
  .filter((e) => (e.data.end ?? e.data.start) >= today)
  .sort((a, b) => a.data.start.getTime() - b.data.start.getTime())
  .slice(0, 4);

const LABEL: Record<string, string> = { services: 'services', projects: 'projects', activities: 'communities', events: 'events', people: 'people', members: 'members' };
const areas = await Promise.all(
  home.thematic.map(async (slug) => {
    const r = DIRECTORY.area.records.find((a) => a.slug === slug)!;
    const links = await linksFor('area', slug);
    const counts = (['services', 'projects', 'activities', 'events'] as const)
      .filter((k) => links[k]?.length)
      .map((k) => ({ n: links[k]!.length, label: LABEL[k] }))
      .slice(0, 3);
    return { ...r, illustration: (home.areaIllustrations as Record<string, string>)[slug], counts };
  }),
);

// Where the UK leads: Clubs plus the ELIXIR Communities and groups ELIXIR-UK leads
const leads = DIRECTORY.activities.records.filter((a) => a.tags.includes('Leading') || a.tags.includes('Club'));
const thisYear = new Date().getFullYear();
const evBars = stats.events.map((e) => ({ label: String(e.year), value: e.count, note: e.year === thisYear ? 'so far this year' : undefined }));
const day = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', timeZone: 'UTC' });
const month = (d: Date) => d.toLocaleDateString('en-GB', { month: 'short', timeZone: 'UTC' });

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'ELIXIR-UK',
  url: 'https://elixiruknode.org',
  parentOrganization: { '@type': 'Organization', name: 'ELIXIR', url: 'https://elixir-europe.org' },
  member: DIRECTORY.members.records.map((m) => ({ '@type': 'Organization', name: m.name })),
};
---
<BaseLayout description={home.intro} {jsonLd}>
  <!-- 1. Who we are -->
  <section class="banner hero">
    <div class="hero__stage">
    <HeroShapes />
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="eyebrow-sm hero__eyebrow">{home.heroEyebrow}</p>
        <h1 class="display hero__title">ELIXIR-UK<span class="stop">.</span></h1>
        <p class="hero__intro">{home.intro}</p>
        <div class="hero__actions">
          <a class="btn" href={url('/new-members/')}>Become a member</a>
          <a class="btn btn--ghost" href={home.video}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10.5" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M10 8.5v7l6-3.5z" fill="currentColor"/></svg>
            Watch our story
          </a>
        </div>
      </div>
    </div>
    </div>
    <div class="container hero__facts-wrap">
      <dl class="hero__facts">
        <div><dt>Member organisations</dt><dd>{stats.members}</dd></div>
        <div><dt>Endorsed services</dt><dd>{stats.services}</dd></div>
        <div><dt>Communities and groups</dt><dd>{stats.communities}</dd></div>
        <div><dt>Projects</dt><dd>{stats.projects}</dd></div>
      </dl>
    </div>
  </section>

  <!-- 2. Mission -->
  <section class="section mission-wrap" aria-labelledby="mission-h">
    <div class="container">
      <div class="section-head">
        <div>
          <h2 class="section-title" id="mission-h">Our mission<span class="stop">.</span></h2>
          <p>Four pillars hold the Node together.</p>
        </div>
      </div>
      <div class="mission">
        {home.mission.map((m, i) => (
          <a class:list={['mission__card', { 'is-highlight': m.highlight }]} href={url(m.href)} data-reveal="fade-up" style={`--delay:${i * 70}ms`}>
            <span class="mission__art"><img src={asset(m.illustration)} alt="" loading="lazy" decoding="async" /></span>
            <span class="mission__body">
              <span class="mission__title">{m.title}<span class="stop">.</span></span>
              <span class="mission__text">{m.text}</span>
              {m.draft && <span class="draft">Draft wording</span>}
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. Evidence -->
  <section class="banner numbers" aria-labelledby="numbers-h">
    <div class="container">
      <div class="section-head">
        <div>
          <h2 class="section-title" id="numbers-h">The Node in numbers<span class="stop">.</span></h2>
          <p class="numbers__sub">Counted from the records behind this site, updated on every build.</p>
        </div>
      </div>
      <div class="numbers__top">
      <div class="numbers__map"><UkMap /><p class="numbers__hint">Select a dot to see the members in that city.</p></div>
      <ul class="kpis">
        <li><a href={url('/members/')}><strong>{stats.members}</strong><span>member organisations</span></a></li>
        <li><a href={url('/services/')}><strong>{stats.services}</strong><span>endorsed services</span></a></li>
        <li><a href={url('/activities/')}><strong>{stats.communities}</strong><span>communities and groups, {stats.leading} UK-led</span></a></li>
        <li><a href={url('/projects/')}><strong>{stats.projects}</strong><span>projects</span></a></li>
        <li><a href={url('/people/')}><strong>{stats.people}</strong><span>people with a profile</span></a></li>
        <li><a href={url('/events/')}><strong>{stats.events.reduce((a, e) => a + e.count, 0)}</strong><span>events since {stats.events[0]?.year}</span></a></li>
      </ul>
      </div>
      <div class="charts">
        <div class="chart-card">
          <h3>Member organisations since {stats.firstYear}</h3>
          <p>From {stats.founding} founding members to {stats.members} today.</p>
          <GrowthChart data={stats.growth} title="Member organisations by year" />
        </div>
        <div class="chart-card">
          <h3>Events and Community Calls</h3>
          <p>Listed on the site, per year.</p>
          <BarChart data={evBars} title="Events per year" />
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Thematic areas -->
  <section class="section" aria-labelledby="areas-h">
    <div class="container">
      <div class="section-head">
        <div>
          <h2 class="section-title" id="areas-h">Thematic areas<span class="stop">.</span></h2>
          <p>Each area gathers the communities, services, projects and people working on it.</p>
        </div>
        <a class="more-link" href={url('/area/')}>All thematic areas</a>
      </div>
      <div class="areas">
        {areas.map((a, i) => (
          <a class="area" href={url(`/area/${a.slug}/`)} data-reveal="fade-up" style={`--delay:${i * 80}ms`}>
            <span class="area__art">{a.illustration && <img src={asset(a.illustration)} alt="" loading="lazy" decoding="async" />}</span>
            <span class="area__title">{a.name}</span>
            {a.counts.length > 0 && <span class="area__counts">{a.counts.map((c) => <span><b>{c.n}</b> {c.label}</span>)}</span>}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. Where the UK leads -->
  <section class="section section--grey" aria-labelledby="leads-h">
    <div class="container leads">
      <div class="leads__intro">
        <h2 class="section-title" id="leads-h">Where the UK leads<span class="stop">.</span></h2>
        <p>ELIXIR-UK runs its own Clubs and co-leads {leads.filter((l) => !l.tags.includes('Club')).length} ELIXIR Communities and groups across Europe.</p>
        <a class="more-link" href={url('/activities/')}>All communities</a>
      </div>
      <ul class="leads__grid">
        {leads.map((l) => (
          <li>
            <a href={url(`/activities/${l.slug}/`)}>
              <span class="icon-disc">{l.logo ? <img src={localAsset(l.logo)} alt="" loading="lazy" /> : <b>{l.name[0]}</b>}</span>
              <span class="leads__name">{l.name}</span>
              <span class="leads__kind">{l.tags.includes('Club') ? 'ELIXIR-UK Club' : 'ELIXIR Community'}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 6. What's new -->
  <section class="section" aria-labelledby="news-h">
    <div class="container">
      <div class="section-head">
        <h2 class="section-title" id="news-h">What’s new<span class="stop">.</span></h2>
        <a class="more-link" href={url('/news/')}>All news and stories</a>
      </div>
      <div class="news-tiles">
        {news.map((n, i) => i === 0 ? (
          <a class="tile news-tile news-tile--photo" href={url(`/news/${n.id}/`)}>
            {n.data.image && <RemoteImage class="ph-img" src={n.data.image} width={900} />}
            <span class="ph-slide"></span>
            <span class="scrim">
              <span class="news-tile__meta">{n.data.category} · {longDate(n.data.date)}</span>
              <span class="news-tile__title news-tile__title--big">{n.data.title}</span>
            </span>
          </a>
        ) : (
          <a class:list={['news-tile', i === 1 ? 'news-tile--navy' : 'news-tile--blue']} href={url(`/news/${n.id}/`)}>
            <span class="news-tile__meta">{n.data.category} · {longDate(n.data.date)}</span>
            <span class="news-tile__title">{n.data.title}</span>
            {n.data.standfirst && <span class="news-tile__sum">{firstSentence(n.data.standfirst, 140)}</span>}
            <span class="news-tile__more">Read the story</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 7. Coming up -->
  {upcoming.length > 0 && (
    <section class="banner coming" aria-labelledby="coming-h">
      <img class="coming__art" src={asset('illustration-isometrics-mechanisms-like-extending-hand-join.svg')} alt="" loading="lazy" />
      <div class="container coming__grid">
        <div>
          <h2 class="section-title" id="coming-h">Coming up<span class="stop">.</span></h2>
          <p>Community Calls, workshops and the All Hands meeting.</p>
          <a class="more-link" href={url('/events/')}>All events</a>
        </div>
        <ol class="coming__list">
          {upcoming.map((e) => (
            <li>
              <a href={url(`/events/${e.id}/`)}>
                <span class="coming__date"><b>{day(e.data.start)}</b><span>{month(e.data.start)}</span></span>
                <span class="coming__body">
                  <span class="coming__type">{e.data.type}{e.data.online ? ' · Online' : ''}</span>
                  <span class="coming__title">{e.data.title}</span>
                </span>
                <span class="coming__go" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  <!-- 8. Services -->
  <section class="section services-band" aria-labelledby="svc-h">
    <div class="container services-band__grid">
      <div>
        <p class="eyebrow-sm">Open-access services</p>
        <h2 class="section-title" id="svc-h"><span class="services-band__num">{services.length}</span> services, endorsed<span class="stop">.</span></h2>
        <p>Selected by ELIXIR-UK for quality, use and sustainability, and free for the life sciences community.</p>
        <a class="btn" href={url('/services/')}>Discover our services</a>
      </div>
      <ul class="services-band__logos" aria-label="Endorsed services">
        {services.filter((s) => s.logo).slice(0, 15).map((s) => (
          <li><a href={url(`/services/${s.slug}/`)} title={s.name}><RemoteImage src={s.logo} width={200} alt={s.name} /></a></li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero { min-height: min(88vh, 780px); display: flex; flex-direction: column; padding: 0; }
  .hero__stage { position: relative; flex: 1; display: flex; align-items: center; padding-block: clamp(56px, 7vw, 96px); isolation: isolate; }
  .hero__stage > .container { width: min(100% - 2 * var(--gutter), var(--container)); }
  .hero__grid { position: relative; }
  .hero__copy { max-width: min(640px, 52%); padding: var(--s5) 0; }
  @media (max-width: 900px) { .hero__copy { max-width: none; } }
  .hero__eyebrow { color: var(--orange-soft); }
  .hero__title { font-size: clamp(3rem, 1.8rem + 6vw, 7rem); margin: 0; }
  .hero__intro { margin: var(--s5) 0 var(--s6); max-width: 34rem; font-size: var(--fs-lead); line-height: 1.55; color: var(--on-dark); }
  .hero__actions { display: flex; gap: var(--s3); flex-wrap: wrap; }
  .hero__facts-wrap { margin-top: auto; }
  .hero__facts { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin: 0; border-top: 1px solid rgb(255 255 255 / 0.14); }
  .hero__facts div { display: flex; flex-direction: column-reverse; gap: 4px; padding: var(--s5) var(--s5) var(--s6) 0; }
  .hero__facts div + div { padding-left: var(--s5); border-left: 1px solid rgb(255 255 255 / 0.14); }
  .hero__facts dt { font-size: var(--fs-sm); color: #9fbcd0; }
  .hero__facts dd { margin: 0; font-size: clamp(2rem, 1.4rem + 2vw, 3.25rem); font-weight: 900; line-height: 1; color: var(--white); letter-spacing: -0.02em; }
  .numbers__top { display: grid; grid-template-columns: minmax(220px, 0.7fr) minmax(0, 2fr); gap: clamp(32px, 5vw, 80px); align-items: center; margin-bottom: var(--s7); }
  .numbers__map { max-width: 320px; }
  .numbers__hint { margin: var(--s3) 0 0; text-align: center; font-size: var(--fs-xs); color: #8fa9bc; }

  /* Mission */
  .mission { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--s4); }
  .mission__card { display: flex; flex-direction: column; border-radius: var(--radius-lg); background: var(--white); border: 1px solid var(--border); overflow: hidden; color: var(--text); transition: transform 0.25s var(--ease), box-shadow 0.25s var(--ease); }
  .mission__card:hover { color: var(--text); transform: translateY(-4px); box-shadow: var(--shadow-hover); }
  .mission__art { display: flex; align-items: center; justify-content: center; aspect-ratio: 4 / 3; background: var(--grey-light); padding: var(--s5); }
  .mission__art img { max-width: 100%; max-height: 180px; object-fit: contain; transition: transform 0.4s var(--ease); }
  .mission__card:hover .mission__art img { transform: scale(1.05); }
  .mission__body { display: flex; flex-direction: column; gap: var(--s2); padding: var(--s5); flex: 1; }
  .mission__title { font-size: 1.3rem; font-weight: 700; line-height: 1.2; color: var(--navy); }
  .mission__text { font-size: var(--fs-sm); line-height: 1.5; }
  .mission .draft { align-self: flex-start; margin-top: auto; }
  .mission__card.is-highlight { border-color: var(--orange); }
  .mission__card.is-highlight .mission__art { background: #fff1e6; }

  /* Numbers */
  .numbers { padding-block: var(--section-pad); }
  .numbers__sub { color: #9fbcd0; }
  .kpis { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .kpis li { border-top: 1px solid rgb(255 255 255 / 0.12); }
  .kpis li:nth-child(3n+1) { border-left: 0 !important; }
  .kpis li:nth-child(3n+1) a { padding-left: 0 !important; }
  .kpis li + li { border-left: 1px solid rgb(255 255 255 / 0.12); }
  .kpis a { display: flex; flex-direction: column; gap: var(--s2); padding: var(--s5) var(--s5) var(--s5) 0; color: var(--on-dark); }
  .kpis li + li a { padding-left: var(--s5); }
  .kpis strong { font-size: clamp(2.5rem, 1.6rem + 3vw, 4.25rem); font-weight: 900; line-height: 0.95; color: var(--white); letter-spacing: -0.03em; transition: color 0.2s; }
  .kpis span { font-size: var(--fs-sm); line-height: 1.35; }
  .kpis a:hover strong { color: var(--orange); }
  .charts { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: var(--s4); }
  .chart-card { padding: var(--s6); border-radius: var(--radius-lg); background: rgb(255 255 255 / 0.04); border: 1px solid rgb(255 255 255 / 0.08); }
  .chart-card h3 { color: var(--white); font-size: 1.15rem; margin: 0 0 var(--s1); }
  .chart-card p { font-size: var(--fs-sm); color: #9fbcd0; margin: 0 0 var(--s5); }

  /* Areas */
  .areas { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s5); }
  .area { display: flex; flex-direction: column; gap: var(--s3); color: var(--text); }
  .area:hover { color: var(--text); }
  .area__art { display: flex; align-items: center; justify-content: center; aspect-ratio: 5 / 4; padding: var(--s6); border-radius: var(--radius-lg); background: var(--grey-light); overflow: hidden; transition: background 0.3s var(--ease); }
  .area__art img { max-width: 100%; max-height: 220px; object-fit: contain; transition: transform 0.5s var(--ease); }
  .area:hover .area__art { background: #e7eef3; }
  .area:hover .area__art img { transform: scale(1.06); }
  .area__title { margin-top: var(--s2); font-size: 1.4rem; font-weight: 700; line-height: 1.2; color: var(--navy); }
  .area:hover .area__title { color: var(--orange-text); }
  .area__counts { display: flex; gap: var(--s4); flex-wrap: wrap; font-size: var(--fs-sm); color: var(--muted); }
  .area__counts b { color: var(--navy); }

  /* Leads */
  .leads { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 2fr); gap: clamp(32px, 5vw, 80px); align-items: start; }
  .leads__intro p { margin: var(--s4) 0 var(--s5); }
  .leads__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--s3); }
  .leads__grid a { display: flex; flex-direction: column; align-items: center; text-align: center; gap: var(--s2); height: 100%; padding: var(--s5) var(--s3); border-radius: var(--radius-lg); background: var(--white); color: var(--text); transition: box-shadow 0.25s var(--ease), transform 0.25s var(--ease); }
  .leads__grid a:hover { color: var(--text); transform: translateY(-3px); box-shadow: var(--shadow-hover); }
  .leads__grid .icon-disc { width: 72px; border: 0; background: var(--grey-light); }
  .leads__grid .icon-disc b { font-size: 1.6rem; color: var(--navy); }
  .leads__name { font-weight: 700; color: var(--navy); line-height: 1.25; font-size: var(--fs-sm); }
  .leads__kind { font-size: var(--fs-xs); color: var(--muted); }

  /* News */
  .news-tiles { display: grid; grid-template-columns: 2fr 1fr 1fr; grid-auto-rows: minmax(400px, auto); gap: var(--s4); }
  .news-tile { display: flex; flex-direction: column; gap: var(--s3); padding: var(--s6); border-radius: var(--radius-lg); color: var(--white); transition: transform 0.3s var(--ease); }
  .news-tile:hover { color: var(--white); }
  .news-tile:not(.tile):hover { transform: translateY(-4px); }
  .news-tile--photo { padding: 0; background: var(--blue); }
  .news-tile--photo .scrim { padding: var(--s6); gap: var(--s3); }
  .news-tile--navy { background: var(--navy); }
  .news-tile--blue { background: var(--blue-dark); }
  .news-tile__meta { font-size: var(--fs-xs); font-weight: 700; letter-spacing: 0.04em; color: var(--orange-soft); }
  .news-tile--blue .news-tile__meta { color: var(--white); opacity: 0.85; }
  .news-tile__title { font-size: 1.4rem; font-weight: 700; line-height: 1.22; }
  .news-tile__title--big { font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem); max-width: 30ch; }
  .news-tile__sum { font-size: var(--fs-sm); line-height: 1.5; opacity: 0.85; }
  .news-tile__more { margin-top: auto; font-weight: 700; font-size: var(--fs-sm); }
  .news-tile__more::after { content: ' →'; }

  /* Coming up */
  .coming { padding-block: var(--section-pad); }
  .coming__art { position: absolute; right: -60px; bottom: -40px; width: 460px; opacity: 0.12; filter: invert(1) grayscale(1); pointer-events: none; }
  .coming__grid { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 2fr); gap: clamp(32px, 5vw, 80px); align-items: start; }
  .coming__grid > div p { margin: var(--s4) 0 var(--s5); }
  .coming__list { list-style: none; margin: 0; padding: 0; border-top: 1px solid rgb(255 255 255 / 0.14); }
  .coming__list a { display: grid; grid-template-columns: 72px minmax(0, 1fr) auto; gap: var(--s5); align-items: center; padding: var(--s5) 0; border-bottom: 1px solid rgb(255 255 255 / 0.14); color: var(--white); }
  .coming__date { display: flex; flex-direction: column; align-items: center; justify-content: center; aspect-ratio: 1; border-radius: var(--radius-lg); background: rgb(255 255 255 / 0.06); line-height: 1; }
  .coming__date b { font-size: 1.9rem; font-weight: 900; }
  .coming__date span { font-size: var(--fs-xs); text-transform: uppercase; letter-spacing: 0.08em; color: #9fbcd0; margin-top: 4px; }
  .coming__body { display: flex; flex-direction: column; gap: 4px; }
  .coming__type { font-size: var(--fs-xs); font-weight: 700; color: var(--orange-soft); }
  .coming__title { font-size: 1.2rem; font-weight: 700; line-height: 1.3; }
  .coming__go { font-size: 1.3rem; color: var(--orange); transition: transform 0.2s var(--ease); }
  .coming__list a:hover .coming__title { color: var(--orange-soft); }
  .coming__list a:hover .coming__go { transform: translateX(4px); }

  /* Services */
  .services-band { background: var(--grey-light); }
  .services-band__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); gap: clamp(32px, 5vw, 80px); align-items: center; }
  .services-band__grid > div p:not(.eyebrow-sm) { margin: var(--s4) 0 var(--s5); max-width: 30rem; }
  .services-band__num { color: var(--orange-text); }
