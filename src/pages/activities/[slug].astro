---
import Crumbs from '../../components/Crumbs.astro';
// Community page: the group's icon, its excerpt and join link; next call; the WordPress copy
// (accordions rebuilt); everyone involved – leads first, then members, each person once;
// the community's events; its stories; then other related records.
// The Fellowship uses the same page with a fellows-first layout.
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Avatar from '../../components/Avatar.astro';
import PersonLine from '../../components/PersonLine.astro';
import RemoteImage from '../../components/RemoteImage.astro';
import RelatedCards from '../../components/RelatedCards.astro';
import SmartTabs from '../../components/SmartTabs.astro';
import { DIRECTORY, linksFor } from '../../lib/graph';
import { involved } from '../../lib/involved';
import { cardsFor } from '../../lib/lookup';
import { localAsset } from '../../lib/assets';
import { longDate, todayUK, firstSentence, needsStop } from '../../lib/format';
import { url } from '../../lib/url';
import { cleanHtml } from '../../lib/html';
import { isCurrent } from '../../lib/people';

export function getStaticPaths() {
  return DIRECTORY.activities.records.map((record) => ({ params: { slug: record.slug }, props: { record } }));
}
const { record: r } = Astro.props;
const links = await linksFor('activities', r.slug);
const allEvents = await getCollection('events');
const today = todayUK();
const events = (links.events ?? []).map((n) => allEvents.find((e) => e.id === n.slug)!).filter(Boolean);
const upcoming = events.filter((e) => (e.data.end ?? e.data.start) >= today).sort((a, b) => a.data.start.getTime() - b.data.start.getTime());
const past = events.filter((e) => (e.data.end ?? e.data.start) < today).sort((a, b) => b.data.start.getTime() - a.data.start.getTime());
const next = upcoming[0];
const { leads, others } = await involved('activities', r);
const stories = await cardsFor('news', (links.news ?? []).map((n) => n.slug));
const isFellowship = r.slug === 'fellowship';
const kind = isFellowship ? 'Fellowship' : r.tags.find((t) => ['Club', 'Community', 'Focus Group', 'Platform'].includes(t)) ?? 'Community';
const isClub = kind === 'Club';
const kindLabel = ({ Club: 'ELIXIR-UK Club', Community: 'ELIXIR Community', 'Focus Group': 'ELIXIR Focus Group', Platform: 'ELIXIR Platform', Fellowship: 'ELIXIR-UK Fellowship' } as Record<string, string>)[kind];
const lead = r.tags.includes('Leading');
const body = await cleanHtml(r.body || `<p>${r.summary}</p>`);
const fellows = isFellowship ? others : [];
const OTHERS_SHOWN = 12;
const fmt = (e: (typeof events)[number]) => (e.data.format === 'in-person' ? e.data.locality || 'In person' : e.data.format === 'hybrid' ? 'Hybrid' : 'Online');
const jsonLd = { '@context': 'https://schema.org', '@type': 'Organization', name: r.name, description: r.excerpt || r.summary || undefined, logo: r.logo || undefined, parentOrganization: { '@type': 'Organization', name: 'ELIXIR-UK' } };
---
<BaseLayout title={r.name} description={r.excerpt || firstSentence(r.summary)} {jsonLd}>
  <section class="c-hero">
    <div class="container c-hero__grid">
      <div>
        <Crumbs items={[{ label: 'Communities of practice', href: '/activities/' }, { label: r.name }]} />
        <p class="eyebrow-sm">{kindLabel}{lead && ' · UK co-leads'}</p>
        <h1 class="display c-hero__title">{r.name}{needsStop(r.name) && <span class="stop">.</span>}</h1>
        {(r.excerpt || r.summary) && <p class="c-hero__lead">{r.excerpt || firstSentence(r.summary, 260)}</p>}
        <div class="c-hero__actions">
          {r.joinLink && <a class="btn" href={r.joinLink} rel="noopener">{isClub ? 'Join the Club' : 'Join in'}</a>}
          {r.website && !r.website.includes('elixiruknode.org') && <a class="btn btn--line" href={r.website} rel="noopener">Visit website</a>}
        </div>
      </div>
      <div class="c-hero__icon">
        <Avatar src={r.logo ? localAsset(r.logo) : undefined} name={r.name} size={260} logo ring="var(--grey-light)" eager />
      </div>
    </div>
  </section>

  {next && (
    <a class="c-next" href={url(`/events/${next.id}/`)}>
      <span class="container c-next__inner">
        <span class="c-next__label">Next {next.data.type === 'Community Call' ? 'call' : 'event'}</span>
        <strong>{longDate(next.data.start)}{next.data.startTime && `, ${next.data.startTime}`}</strong>
        <span class="c-next__title">{next.data.title}</span>
        <span class="c-next__go">{next.data.type === 'Community Call' ? 'Join in' : 'Register'} →</span>
      </span>
    </a>
  )}

  {isFellowship && fellows.length > 0 && (
    <section class="container f-people">
      <div class="section-head"><h2 class="section-title">People in the Fellowship<span class="stop">.</span></h2></div>
      <ul class="f-grid">
        {[...leads, ...fellows.filter((p) => !leads.includes(p))].map((p) => (
          <li><PersonLine p={p} size={72} badge={leads.includes(p) ? 'Lead' : undefined} /></li>
        ))}
      </ul>
    </section>
  )}

  <section class="container c-body">
    <div class="prose c-copy" set:html={body} />
    {!isFellowship && (leads.length > 0 || others.length > 0) && (
      <aside class="c-side" aria-label="People">
        {leads.length > 0 && (
          <div class="c-box">
            <p class="c-box__title">{leads.length === 1 ? 'Lead' : 'Leads'} <span>{leads.length}</span></p>
            <ul>{leads.map((p) => (
              <li>
                <PersonLine p={p} ring="var(--grey-light)" />
                {isClub && p.data.email && <a class="c-mail" href={`mailto:${p.data.email}`}>{p.data.email}</a>}
              </li>
            ))}</ul>
          </div>
        )}
        {others.length > 0 && (
          <div class="c-box">
            <p class="c-box__title">{leads.length ? 'Also involved' : 'People involved'} <span>{others.length}</span></p>
            <ul class="c-others">
              {others.map((p, i) => <li hidden={i >= OTHERS_SHOWN}><PersonLine p={p} size={44} ring="var(--grey-light)" /></li>)}
            </ul>
            {others.length > OTHERS_SHOWN && <button type="button" class="c-more" data-more-people>Show all {others.length}</button>}
          </div>
        )}
      </aside>
    )}
  </section>

  {stories.length > 0 && (
    <section class="section c-stories" aria-labelledby="st-h">
      <div class="container">
        <div class="section-head"><h2 class="section-title" id="st-h">Stories from the {isClub ? 'Club' : isFellowship ? 'Fellowship' : 'community'}<span class="stop">.</span></h2></div>
        <RelatedCards cards={stories} limit={3} />
      </div>
    </section>
  )}

  <section class="container c-related">
    <SmartTabs kind="activities" slug={r.slug} display={r.display} skip={['news', 'events', 'people']} heading="Also linked" />
  </section>

  {events.length > 0 && (
    <section class="container c-evs" aria-labelledby="ev-h">
      <div class="section-head"><h2 class="section-title" id="ev-h">{isClub ? 'Community Calls' : 'Events'}<span class="stop">.</span></h2><a class="more-link" href={url('/events/')}>All events</a></div>
      <div class="c-evs__cols">
        <div>
          <h3 class="c-sub">Coming up</h3>
          {upcoming.length ? (
            <ul class="evlist">{upcoming.map((e) => (
              <li><a href={url(`/events/${e.id}/`)}><span class="evlist__date">{e.data.start.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' })}</span><span class="evlist__title">{e.data.title}</span><span class="evlist__meta">{fmt(e)}{e.data.startTime && ` · ${e.data.startTime}`}</span></a></li>
            ))}</ul>
          ) : <p class="c-none">Nothing scheduled yet{r.joinLink ? ' – join to hear about the next one.' : '.'}</p>}
        </div>
        {past.length > 0 && (
          <div>
            <h3 class="c-sub">Past</h3>
            <ul class="evlist">{past.map((e, i) => (
              <li hidden={i >= 8}><a href={url(`/events/${e.id}/`)}><span class="evlist__date">{e.data.start.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' })}</span><span class="evlist__title">{e.data.title}</span>{e.data.recording && <span class="evlist__rec">▶ Recording</span>}</a></li>
            ))}</ul>
            {past.length > 8 && <button type="button" class="c-more" data-more-people>Show all {past.length}</button>}
          </div>
        )}
      </div>
    </section>
  )}

  {r.joinLink && (
    <section class="banner c-join-band">
      <div class="container c-join">
        <div>
          <h2 class="section-title">Be part of it<span class="stop">.</span></h2>
          <p>{isClub ? 'Joining is free. You’ll get invitations to every Community Call and news from the Club.' : 'Find out how to take part.'}</p>
        </div>
        <a class="btn c-join__btn" href={r.joinLink} rel="noopener">{isClub ? 'Join the Club' : 'Join in'}</a>
      </div>
    </section>
  )}
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-more-people]').forEach((b) => b.addEventListener('click', () => {
    (b.previousElementSibling ?? b.parentElement)?.querySelectorAll<HTMLElement>('li[hidden]').forEach((li) => (li.hidden = false));
    b.remove();
  }));
</script>

<style>
  .c-hero { background: var(--grey-light); }
  .c-hero__grid { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: clamp(32px, 5vw, 80px); align-items: center; padding-block: clamp(48px, 6vw, 80px); }
  .c-hero__title { font-size: clamp(2.4rem, 1.6rem + 3vw, 4rem); margin: 0; color: var(--navy); }
  .c-hero__lead { margin: var(--s5) 0 var(--s6); max-width: 40rem; font-size: var(--fs-lead); line-height: 1.55; color: #2f3e49; }
  .c-hero__actions { display: flex; gap: var(--s3); flex-wrap: wrap; }
  .c-hero .crumb a { color: var(--blue-dark); }
  .c-hero__icon { justify-self: center; }
  .c-hero__icon :global(.avatar img) { padding: 20% !important; box-shadow: 0 20px 50px rgb(2 52 82 / 0.12); }
  .c-next { display: block; background: var(--navy); color: var(--white); }
  .c-next:hover { color: var(--white); background: var(--ink); }
  .c-next__inner { display: flex; align-items: center; gap: var(--s5); flex-wrap: wrap; padding-block: var(--s4); }
  .c-next__label { font-size: var(--fs-sm); font-weight: 700; letter-spacing: 0;  color: var(--orange-soft); }
  .c-next__title { flex: 1 1 320px; }
  .c-next__go { font-weight: 700; color: var(--orange-soft); }
  .c-body { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: clamp(32px, 5vw, 80px); padding-block: var(--s8); align-items: start; }
  .c-body:not(:has(.c-side)) { grid-template-columns: minmax(0, 1fr); }
  .c-copy { max-width: 70ch; }
  .c-side { display: flex; flex-direction: column; gap: var(--s4); position: sticky; top: 100px; }
  .c-box { padding: var(--s5); border-radius: var(--radius-lg); background: var(--grey-light); }
  .c-box ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .c-box__title { margin: 0 0 var(--s3); font-size: var(--fs-sm); font-weight: 700; letter-spacing: 0;  color: var(--navy); }
  .c-box__title span { color: var(--orange-text); margin-left: 4px; }
  .c-mail { display: block; margin: -2px 0 var(--s2) 68px; font-size: var(--fs-xs); font-weight: 700; color: var(--blue-dark); word-break: break-all; }
  .c-more { margin-top: var(--s3); font: inherit; font-size: var(--fs-sm); font-weight: 700; color: var(--blue-dark); background: none; border: 0; padding: 0; cursor: pointer; }
  .f-people { padding-top: var(--s8); }
  .f-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: var(--s2) var(--s5); }
  .c-sub { font-size: var(--fs-h3); margin: 0 0 var(--s4); }
  .c-up + .c-sub, .c-sub ~ .c-sub { margin-top: var(--s7); }
  .c-up { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); gap: var(--s4); }
  .c-up li { display: flex; }
  .c-upcard { flex: 1; flex-direction: row; gap: var(--s4); align-items: center; }
  .c-upcard > span:last-child { display: flex; flex-direction: column; gap: 4px; }
  .c-date { flex: none; display: flex; flex-direction: column; align-items: center; width: 60px; padding: 6px 0; border-radius: 8px; background: var(--navy); color: var(--white); line-height: 1.1; }
  .c-date span { font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; color: #9fbcd0; }
  .c-date b { font-size: 1.6rem; font-weight: 900; }
  .c-past { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s4); }
  .c-past__tile { aspect-ratio: 16 / 10; border-radius: var(--radius-lg); background: var(--navy); }
  .c-play { position: absolute; right: var(--s4); top: var(--s4); display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: var(--white); color: var(--navy); }
  .c-play svg { width: 20px; height: 20px; }
  .c-past__date { font-size: var(--fs-xs); color: var(--orange-soft); font-weight: 700; }
  .c-past__title { font-size: 1.1rem; font-weight: 700; line-height: 1.25; }
  .c-pastmore { margin: var(--s5) 0 0; font-size: var(--fs-sm); }
  .c-related { padding-top: var(--s6); }
  .c-evs { padding-block: var(--s8) var(--section-pad); }
  .c-evs__cols { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s7); }
  .evlist { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--border); }
  .evlist a { display: grid; grid-template-columns: 110px minmax(0, 1fr) auto; gap: var(--s3); align-items: baseline; padding: var(--s3) 0; border-bottom: 1px solid var(--border); color: var(--text); }
  .evlist a:hover .evlist__title { color: var(--orange-text); }
  .evlist__date { font-size: var(--fs-sm); font-weight: 700; color: var(--orange-text); font-variant-numeric: tabular-nums; }
  .evlist__title { font-weight: 700; color: var(--navy); line-height: 1.3; }
  .evlist__meta, .evlist__rec { font-size: var(--fs-xs); color: var(--muted); white-space: nowrap; }
  .evlist__rec { color: var(--blue-dark); font-weight: 700; }
  .c-none { color: var(--muted); }
  @media (max-width: 800px) { .c-evs__cols { grid-template-columns: 1fr; } .evlist a { grid-template-columns: 1fr; gap: 2px; } }
  .c-join-band { padding-block: clamp(64px, 8vw, 96px); }
  .c-join { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--s7); align-items: center; }
  .c-join p { margin: var(--s3) 0 0; color: var(--on-dark); }
  .c-join__btn { font-size: 1.05rem; min-height: 56px; padding: 0 2em; }
  @media (max-width: 900px) {
    .c-hero__grid, .c-body, .c-join { grid-template-columns: 1fr; }
    .c-hero__icon { justify-self: start; order: -1; }
    .c-hero__icon :global(.avatar) { width: 120px !important; }
    .c-side { position: static; }
    .c-past { grid-template-columns: 1fr; }
  }
</style>
