---
import { cleanHtml } from '../../lib/html';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import RemoteImage from '../../components/RemoteImage.astro';
import SmartTabs from '../../components/SmartTabs.astro';
import { longDate } from '../../lib/format';
import { tagSlug } from '../../lib/graph';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const news = await getCollection('news');
  return news.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
await render(entry);
const html = await cleanHtml(entry.rendered?.html ?? '');
const n = entry.data;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: n.title,
  datePublished: n.date.toISOString().slice(0, 10),
  image: n.image,
  description: n.standfirst,
  publisher: { '@type': 'Organization', name: 'ELIXIR-UK' },
};
---
<BaseLayout title={n.title} description={n.standfirst} {jsonLd}>
  <PageHeader title={n.title} intro={n.standfirst} />
  <article class="article">
    <div class="container article__inner">
      <p class="article__meta">
        <a class="tag" href={url(`/news/category/${tagSlug(n.category)}/`)}>{n.category}</a>
        <time datetime={n.date.toISOString().slice(0, 10)}>{longDate(n.date)}</time>
      </p>
      {n.image && <figure class="article__lead"><RemoteImage src={n.image} width={1200} loading="eager" /></figure>}
      <div class="prose" set:html={html} />
      <div class="article__related">
        <SmartTabs kind="news" slug={entry.id} />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .article { padding-block: 2.5rem 5rem; }
  .article__inner { max-width: 820px; }
  .article__meta { display: flex; align-items: center; gap: 0.75rem; font-size: 14px; margin-bottom: 1.5rem; }
  .article__lead { margin: 0 0 2rem; border-radius: 8px; overflow: hidden; background: var(--grey-light); }
  .article__lead :global(img) { width: 100%; max-height: 460px; object-fit: contain; }
  .article__related { margin-top: 3.5rem; }
</style>
