---
import Crumbs from '../../components/Crumbs.astro';
// News story, editorial layout: light header with category, date, headline and standfirst;
// a wide lead image; a readable text column with share links and the people, communities
// and members in the story alongside; then more stories.
import { cleanHtml } from '../../lib/html';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RemoteImage from '../../components/RemoteImage.astro';
import PersonLine from '../../components/PersonLine.astro';
import RelatedCards from '../../components/RelatedCards.astro';
import SmartTabs from '../../components/SmartTabs.astro';
import { longDate, needsStop } from '../../lib/format';
import { tagSlug, linksFor, shownLinks, DIRECTORY } from '../../lib/graph';
import { cardsFor } from '../../lib/lookup';
import { localAsset } from '../../lib/assets';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const news = await getCollection('news');
  return news.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
await render(entry);
const html = await cleanHtml(entry.rendered?.html ?? '');
const n = entry.data;
const links = await shownLinks('news', entry.id, n.display);
const people = (await getCollection('people')).filter((p) => links.people?.some((x) => x.slug === p.id));
const communities = (links.activities ?? []).map((x) => DIRECTORY.activities.records.find((a) => a.slug === x.slug)!).filter(Boolean);
const members = (links.members ?? []).map((x) => DIRECTORY.members.records.find((a) => a.slug === x.slug)!).filter(Boolean);
const all = (await getCollection('news')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const related = new Set([...(links.activities ?? []).map((x) => x.slug)]);
const more = all.filter((x) => x.id !== entry.id && (x.data.related?.activities ?? []).some((s) => related.has(s))).slice(0, 3);
const moreCards = await cardsFor('news', (more.length ? more : all.filter((x) => x.id !== entry.id).slice(0, 3)).map((x) => x.id));
const words = html.replace(/<[^>]+>/g, ' ').split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 220));
const pageUrl = `https://elixiruknode.org/news/${entry.id}/`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: n.title,
  datePublished: n.date.toISOString().slice(0, 10),
  image: n.image,
  description: n.standfirst,
  publisher: { '@type': 'Organization', name: 'ELIXIR-UK' },
};
---
<BaseLayout title={n.title} description={n.excerpt || n.standfirst} {jsonLd}>
  <article>
    <header class="a-head">
      <div class="container a-head__inner">
        <Crumbs items={[{ label: 'News & stories', href: '/news/' }, { label: n.title }]} />
        <p class="a-meta"><time datetime={n.date.toISOString().slice(0, 10)}>{longDate(n.date)}</time><span>{minutes} min read</span></p>
        <h1 class="display a-title">{n.title}{needsStop(n.title) && <span class="stop">.</span>}</h1>
        {n.standfirst && <p class="a-stand">{n.standfirst}</p>}
      </div>
    </header>
    {n.image && (
      <figure class="container a-lead"><RemoteImage src={n.image} width={1400} loading="eager" /></figure>
    )}
    <div class="container a-body">
      <div class="a-main">
        <div class="prose a-text" set:html={html} />
        <p class="a-share">Share this story:
          <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(pageUrl)}`} rel="noopener">LinkedIn</a>
          <a href={`https://bsky.app/intent/compose?text=${encodeURIComponent(n.title + ' ' + pageUrl)}`} rel="noopener">Bluesky</a>
          <a href={`mailto:?subject=${encodeURIComponent(n.title)}&body=${encodeURIComponent(pageUrl)}`}>Email</a>
        </p>
      </div>
      {(people.length > 0 || communities.length > 0 || members.length > 0) && (
        <aside class="a-in" aria-label="In this story">
          <p class="a-in__h">In this story</p>
          {people.length > 0 && <ul class="a-in__people">{people.map((p) => <li><PersonLine p={p} size={40} /></li>)}</ul>}
          {communities.length > 0 && (
            <ul class="a-in__list">{communities.map((c) => <li><a href={url(`/activities/${c.slug}/`)}><span class="icon-disc">{c.logo ? <img src={localAsset(c.logo)} alt="" /> : <b>{c.name[0]}</b>}</span>{c.name}</a></li>)}</ul>
          )}
          {members.length > 0 && (
            <ul class="a-in__list">{members.map((m) => <li><a href={url(`/members/${m.slug}/`)}>{m.name}</a></li>)}</ul>
          )}
        </aside>
      )}
    </div>
  </article>

  <section class="container a-related">
    <SmartTabs kind="news" slug={entry.id} display={n.display} skip={['people', 'members', 'news']} heading="Related" />
  </section>

  <section class="section section--grey">
    <div class="container">
      <div class="section-head"><h2 class="section-title">More stories<span class="stop">.</span></h2><a class="more-link" href={url('/news/')}>All news and stories</a></div>
      <RelatedCards cards={moreCards} limit={3} />
    </div>
  </section>
</BaseLayout>

<style>
  .a-head { background: var(--grey-light); padding-block: clamp(40px, 5vw, 72px) clamp(56px, 7vw, 120px); }
  .a-head__inner { max-width: 960px; }
  .a-head .crumb a { color: var(--blue-dark); }
  .a-meta { display: flex; gap: var(--s4); margin: 0 0 var(--s4); font-size: var(--fs-sm); color: var(--muted); }
  .a-meta time { font-weight: 700; color: var(--orange-text); }
  .a-title { font-size: clamp(2.2rem, 1.4rem + 3vw, 3.8rem); margin: 0; color: var(--navy); text-wrap: balance; }
  .a-stand { margin: var(--s5) 0 0; font-size: clamp(1.2rem, 1.05rem + 0.6vw, 1.5rem); line-height: 1.45; color: #2f3e49; max-width: 46rem; }
  .a-lead { margin: calc(-1 * clamp(32px, 5vw, 80px)) auto 0; }
  .a-lead :global(img) { width: 100%; max-height: 620px; object-fit: cover; border-radius: var(--radius-lg); box-shadow: var(--shadow); }
  .a-body { display: grid; grid-template-columns: minmax(0, 68ch) minmax(220px, 300px); justify-content: space-between; gap: var(--s7); padding-block: var(--s8) var(--s7); align-items: start; }
  .a-body:not(:has(.a-in)) { grid-template-columns: minmax(0, 68ch); justify-content: center; }
  .a-text { font-size: 1.125rem; line-height: 1.75; }
  .a-text :global(p:first-child) { font-size: 1.2rem; }
  .a-share { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s3); margin: var(--s7) 0 0; padding-top: var(--s5); border-top: 1px solid var(--border); font-size: var(--fs-sm); font-weight: 700; color: var(--navy); }
  .a-share a { font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }
  .a-in { position: sticky; top: 110px; padding: var(--s5); border-radius: var(--radius-lg); background: var(--grey-light); }
  .a-in__h { margin: 0 0 var(--s3); font-size: var(--fs-sm); font-weight: 700; letter-spacing: 0;  color: var(--navy); }
  .a-in ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .a-in ul + ul { margin-top: var(--s4); padding-top: var(--s4); border-top: 1px solid var(--border); }
  .a-in__list a { display: flex; align-items: center; gap: var(--s3); padding: 6px 0; font-weight: 700; font-size: var(--fs-sm); color: var(--navy); }
  .a-in__list .icon-disc { width: 36px; border: 0; }
  .a-related { padding-bottom: var(--s8); }
  @media (max-width: 1100px) {
    .a-body, .a-body:not(:has(.a-in)) { grid-template-columns: minmax(0, 1fr); }
    .a-in { position: static; }
  }
</style>
