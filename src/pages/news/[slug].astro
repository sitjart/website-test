---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { longDate } from '../../lib/format';

export async function getStaticPaths() {
  const news = await getCollection('news');
  return news.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: entry.data.title,
  datePublished: entry.data.date.toISOString().slice(0, 10),
  image: entry.data.image,
  description: entry.data.standfirst,
  publisher: { '@type': 'Organization', name: 'ELIXIR-UK' },
};
---
<BaseLayout title={entry.data.title} description={entry.data.standfirst} {jsonLd}>
  <PageHeader title={entry.data.title} eyebrow={`${entry.data.category} · ${longDate(entry.data.date)}`} intro={entry.data.standfirst} />
  <article class="section">
    <div class="container prose">
      {entry.data.image && <img class="prose__lead" src={entry.data.image} alt="" />}
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .prose { max-width: 760px; font-size: 1.05rem; }
  .prose__lead { border-radius: 8px; margin-bottom: 2rem; width: 100%; }
  .prose :global(img) { border-radius: 6px; margin-block: 1.5rem; }
  .prose :global(figure) { margin: 1.5rem 0; }
  .prose :global(figcaption) { font-size: 14px; color: var(--text); text-align: left; }
  .prose :global(h2), .prose :global(h3) { margin-top: 2rem; }
  .prose :global(blockquote) { border-left: 3px solid var(--orange); margin: 1.5rem 0; padding-left: 1.25rem; font-style: italic; }
</style>
