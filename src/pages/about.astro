---
// Who we are – the WordPress "About" copy, word for word, given a layout:
// intro; role and difference as three-up cards; vision as a statement band;
// what infrastructure means; the Hub-and-Nodes model as a diagram; the Node in figures; who leads the Node.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import PersonLine from '../components/PersonLine.astro';
import { nodeStats } from '../lib/stats';
import { url } from '../lib/url';
import { isCurrent } from '../lib/people';

const stats = await nodeStats();
const people = (await getCollection('people')).filter(isCurrent);
const GOV = ['Heads of Node', 'Coordination office', 'Management Committee', 'Scientific Development Group', 'Scientific and Industry Advisory Board'];
const gov = GOV.map((g) => ({ g, list: people.filter((p) => p.data.governance.includes(g)).sort((a, b) => a.data.name.split(' ').at(-1)!.localeCompare(b.data.name.split(' ').at(-1)!)) })).filter((x) => x.list.length);
const role = [
  { t: 'Enable delivery', d: 'helping teams and individuals to provide world-class data services, resources and training.', icon: 'icon-platform-tools.svg' },
  { t: 'Champion people', d: 'supporting the researchers and technical professionals behind the work.', icon: 'icon-platform-training.svg' },
  { t: 'Amplify voices', d: 'shaping standards and policy at national and international levels.', icon: 'icon-focus-group-comms.svg' },
];
const different = [
  { t: 'Open doors', d: 'equitable access to meetings, collaborations projects and opportunities.' },
  { t: 'Shared leadership', d: 'early voices and established leaders work side by side.' },
  { t: 'Real influence', d: 'contributions at every level shape decisions and influence policy consultations.' },
];
// Distributed ELIXIR diagram: Nodes placed loosely, each linked to its nearest neighbours (a mesh, not spokes);
// the Hub coordinates (faint dashed links); ELIXIR-UK highlighted with its own member organisations around it.
let seed = 11;
const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const nodes: { x: number; y: number; uk?: boolean }[] = [];
for (let gy = 0; gy < 5; gy++) for (let gx = 0; gx < 5; gx++) {
  if ((gx === 2 && gy === 2) || rnd() < 0.12) continue;
  nodes.push({ x: 40 + gx * 55 + (rnd() - 0.5) * 30, y: 40 + gy * 55 + (rnd() - 0.5) * 30 });
}
const hub = { x: 150, y: 150 };
const uk = nodes.reduce((best, n) => (Math.hypot(n.x - 70, n.y - 85) < Math.hypot(best.x - 70, best.y - 85) ? n : best), nodes[0]);
uk.uk = true;
const mesh = new Set<string>();
nodes.forEach((n, i) => {
  nodes.map((m, j) => ({ j, d: Math.hypot(n.x - m.x, n.y - m.y) })).filter((o) => o.j !== i).sort((p, q) => p.d - q.d).slice(0, 3)
    .forEach(({ j }) => mesh.add(i < j ? `${i}-${j}` : `${j}-${i}`));
});
const links = [...mesh].map((k) => k.split('-').map(Number)).map(([i, j]) => [nodes[i], nodes[j]]);
const ukMembers = Array.from({ length: 10 }, (_, i) => { const a = (i / 10) * Math.PI * 2; const r = 26 + (i % 2) * 6; return { x: uk.x + r * Math.cos(a), y: uk.y + r * Math.sin(a) }; });
---
<BaseLayout title="Who we are" description="ELIXIR-UK is the United Kingdom’s national Node of ELIXIR.">
  <PageHeader title="Who we are" intro="ELIXIR-UK is the United Kingdom’s national Node of ELIXIR, the European infrastructure for bioscience data. We are a distributed research infrastructure and a collaborative network, bringing together leading UK research-performing organisations and the people behind them." illustration="illustration-isometrics-mechanisms-like-extending-hand-join.svg" />

  <section class="section">
    <div class="container">
      <div class="split">
        <div><h2 class="section-title">Our role<span class="stop">.</span></h2><p class="lead">Supporting the UK life science community to build, connect and sustain world-class digital research infrastructure.</p></div>
        <ul class="three">
          {role.map((r) => <li class="card"><span class="icon-disc"><img src={url(`/assets/wp/${r.icon}`)} alt="" /></span><b>{r.t}</b><span>{r.d.charAt(0).toUpperCase() + r.d.slice(1)}</span></li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container split">
      <div>
        <h2 class="section-title">What makes us different<span class="stop">.</span></h2>
        <p>ELIXIR-UK is not just a network you belong to, but a community you can actively shape. We ensure equitable access to meetings, collaborations, projects and leadership roles – so that contributions come from every level, not only from the top. This means early-career researchers, technical experts and established leaders work side by side, sharing responsibility for decisions and driving progress together.</p>
      </div>
      <ol class="diff">
        {different.map((r, i) => <li><span class="diff__n">{i + 1}</span><span><b>{r.t}</b><span>{r.d.charAt(0).toUpperCase() + r.d.slice(1)}</span></span></li>)}
      </ol>
    </div>
  </section>

  <section class="banner vision">
    <div class="container">
      <p class="vision__label">Our vision</p>
      <p class="vision__text">A UK research ecosystem where every life-science researcher and technical professional shapes and benefits from a world-leading, collaborative and FAIR digital research infrastructure that is AI-ready<span class="stop">.</span></p>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <h2 class="section-title">What “Infrastructure” means to us<span class="stop">.</span></h2>
      <div class="prose">
        <p>Our infrastructure is not simply a platform, whether digital or physical, it’s the collective expertise, resources and partnerships of our member organisations. ELIXIR-UK’s distributed model ensures that knowledge, innovation and support are accessible across the UK, strengthening both local and national capabilities. We funnel access to funding and community consultations at national and international levels, leveraging our strategic position inside the larger ELIXIR consortium.</p>
        <p>As a distributed infrastructure, a network of UK universities and research institutes, the ELIXIR-UK Node doesn’t directly own or run services. Instead, we support and connect the people who deliver these and enable UK life science research to thrive. We ensure no one works in isolation and the interests of the UK bioscience community are jointly represented when we advocate for policy changes and funding strategies.</p>
      </div>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container hub">
      <figure class="hub__fig" aria-label="ELIXIR as a distributed network: national Nodes linked to each other, the Hub coordinating, and ELIXIR-UK linking its member organisations">
        <svg viewBox="0 0 300 300" role="img" aria-hidden="true">
          {nodes.map((n) => <line x1={hub.x} y1={hub.y} x2={n.x} y2={n.y} class="d-coord" />)}
          {links.map(([n, m]) => <line x1={n.x} y1={n.y} x2={m.x} y2={m.y} class="d-mesh" />)}
          {ukMembers.map((m) => <line x1={uk.x} y1={uk.y} x2={m.x} y2={m.y} class="d-uk-link" />)}
          {ukMembers.map((m) => <circle cx={m.x} cy={m.y} r="3.2" class="d-uk-member" />)}
          {nodes.map((n) => <circle cx={n.x} cy={n.y} r={n.uk ? 11 : 7} class:list={['d-node', { uk: n.uk }]} />)}
          <circle cx={hub.x} cy={hub.y} r="15" class="d-hub" />
          <text x={hub.x} y={hub.y + 30} class="d-label">ELIXIR Hub</text>
          <text x={uk.x} y={uk.y - 42} class="d-label d-label--uk">ELIXIR-UK</text>
        </svg>
        <ul class="d-key">
          <li><span class="k-node"></span>National Nodes, working directly with each other</li>
          <li><span class="k-hub"></span>The Hub, coordinating across Europe</li>
          <li><span class="k-uk"></span>ELIXIR-UK and its member organisations</li>
        </ul>
      </figure>
      <div>
        <h2 class="section-title">Us, the UK Node, inside the larger ELIXIR consortium<span class="stop">.</span></h2>
        <p>The ELIXIR consortium follows a Hub and Spokes model:</p>
        <ul class="hub__list">
          <li><b>The ELIXIR Hub</b> (the headquarters located at the Wellcome Genome Campus) sets strategy and coordinates activities across Europe.</li>
          <li><b>National Nodes</b>, like ELIXIR-UK, are the spokes, bringing together local expertise, resources and priorities.</li>
        </ul>
        <p>ELIXIR-UK connects the UK’s research community to the wider European infrastructure and contributes UK excellence and knowledge to the consortium. Being a member of ELIXIR-UK grants organisations access to the benefits of the entire consortium. This approach ensures that UK teams both benefit from and help shape international collaboration, innovation and standards-enhancing life science research across all participating countries.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <ul class="figs">
        <li><a href={url('/members/')}><b>{stats.members}</b><span>UK research-performing organisations</span></a></li>
        <li><a href={url('/services/')}><b>{stats.services}</b><span>Endorsed open-access services for the life sciences community</span></a></li>
        <li><a href={url('/projects/')}><b>{stats.projects}</b><span>Projects we are participating in or have completed</span></a></li>
        <li><a href={url('/activities/')}><b>{stats.communities}</b><span>Communities and groups we run or take part in</span></a></li>
      </ul>
    </div>
  </section>

  {gov.length > 0 && (
    <section class="section section--grey">
      <div class="container">
        <div class="section-head">
          <h2 class="section-title">Who leads the Node<span class="stop">.</span></h2>
          <a class="more-link" href={url('/people/')}>See all our people</a>
        </div>
        <div class="gov">
          {gov.map(({ g, list }) => (
            <section class="gov__group">
              <h3>{g}</h3>
              <ul>{list.map((p) => <li><PersonLine p={p} size={48} /></li>)}</ul>
            </section>
          ))}
          <a class="gov__group gov__sc" href={url('/members/')}>
            <h3>Steering Committee</h3>
            <p>One representative from each member organisation. Find each organisation’s representative on its member page.</p>
            <span class="more-link">Our members</span>
          </a>
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .split { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.4fr); gap: clamp(32px, 5vw, 80px); align-items: start; }
  .split .lead { margin-top: var(--s4); }
  .split > div > p { margin-top: var(--s4); }
  .three { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s4); }
  .three .card { gap: var(--s2); }
  .three .icon-disc { width: 56px; background: var(--grey-light); border: 0; margin-bottom: var(--s2); }
  .three b { color: var(--navy); font-size: 1.15rem; }
  .three span:last-child { font-size: var(--fs-sm); line-height: 1.5; }
  .diff { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s3); }
  .diff li { display: flex; gap: var(--s4); align-items: flex-start; padding: var(--s5); border-radius: var(--radius-lg); background: var(--white); }
  .diff__n { flex: none; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--orange); color: var(--on-orange); font-weight: 900; }
  .diff li > span:last-child { display: flex; flex-direction: column; gap: 2px; }
  .diff b { color: var(--navy); font-size: 1.1rem; }
  .vision { padding-block: clamp(72px, 9vw, 128px); }
  .vision__label { margin: 0 0 var(--s4); font-weight: 700; color: var(--orange-soft); }
  .vision__text { margin: 0; max-width: 28ch; font-size: clamp(1.8rem, 1.2rem + 2.4vw, 3.2rem); font-weight: 900; line-height: 1.12; letter-spacing: -0.02em; color: var(--white); }
  .hub { display: grid; grid-template-columns: minmax(240px, 0.8fr) minmax(0, 1.4fr); gap: clamp(32px, 5vw, 80px); align-items: center; }
  .hub__fig { margin: 0; }
  .hub__fig svg { width: 100%; max-width: 380px; display: block; margin-inline: auto; overflow: visible; }
  .d-coord { stroke: #c6d6e2; stroke-width: 0.8; stroke-dasharray: 2 3; }
  .d-mesh { stroke: #7fa6bf; stroke-width: 1.4; }
  .d-uk-link { stroke: var(--orange); stroke-width: 1; opacity: 0.7; }
  .d-uk-member { fill: var(--orange); stroke: var(--grey-light); stroke-width: 1.5; }
  .d-node { fill: var(--blue); stroke: var(--grey-light); stroke-width: 2.5; }
  .d-node.uk { fill: var(--orange); }
  .d-hub { fill: var(--navy); stroke: var(--grey-light); stroke-width: 3; }
  .d-label { font: 700 11px var(--font); fill: var(--navy); text-anchor: middle; }
  .d-label--uk { font-weight: 900; fill: var(--orange-text); }
  .d-key { list-style: none; margin: var(--s4) 0 0; padding: 0; display: grid; gap: 6px; font-size: var(--fs-xs); color: var(--text); }
  .d-key li { display: flex; align-items: center; gap: var(--s2); }
  .d-key span { flex: none; width: 12px; height: 12px; border-radius: 50%; }
  .k-node { background: var(--blue); }
  .k-hub { background: var(--navy); }
  .k-uk { background: var(--orange); }
  .hub .section-title { font-size: clamp(1.8rem, 1.3rem + 1.8vw, 2.6rem); margin-bottom: var(--s5); }
  .hub__list { padding-left: 1.2em; }
  .hub__list li { margin-bottom: var(--s2); }
  .hub__list li::marker { color: var(--orange); }
  .figs { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--s6) var(--s5); }
  @media (max-width: 1000px) { .figs { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .figs a { display: flex; flex-direction: column; gap: var(--s2); padding-top: var(--s4); border-top: 3px solid var(--orange); color: var(--text); }
  .figs b { font-size: clamp(2.6rem, 1.8rem + 3vw, 4.2rem); font-weight: 900; line-height: 1; letter-spacing: -0.03em; color: var(--navy); }
  .figs a:hover b { color: var(--orange-text); }
  .figs span { font-size: var(--fs-sm); line-height: 1.4; }
  .gov { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); gap: var(--s5); }
  .gov__group { padding: var(--s5); border-radius: var(--radius-lg); background: var(--white); }
  .gov__group h3 { font-size: 1.1rem; margin: 0 0 var(--s3); }
  .gov__sc { color: var(--text); border: 2px dashed #f3c7a3; }
  .gov__sc:hover { color: var(--text); border-color: var(--orange); }
  .gov__group ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  @media (max-width: 900px) {
    .split, .hub { grid-template-columns: 1fr; }
    .three { grid-template-columns: 1fr; }
  }
</style>
