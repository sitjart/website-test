---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import SmartTabs from '../../components/SmartTabs.astro';
import { longDate, todayUK } from '../../lib/format';
import { tagSlug } from '../../lib/graph';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const events = await getCollection('events');
  return events.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const e = entry.data;
const isPast = (e.end ?? e.start) < todayUK();
const when = e.end && e.end.getTime() !== e.start.getTime() ? `${longDate(e.start)} – ${longDate(e.end)}` : longDate(e.start);
const time = e.startTime ? `${e.startTime}${e.endTime ? `–${e.endTime}` : ''} UK time` : undefined;
const where = e.online ? 'Online' : [e.venue, e.locality].filter(Boolean).join(', ');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: e.title,
  startDate: e.start.toISOString().slice(0, 10),
  endDate: (e.end ?? e.start).toISOString().slice(0, 10),
  eventAttendanceMode: `https://schema.org/${e.online ? 'OnlineEventAttendanceMode' : 'OfflineEventAttendanceMode'}`,
  location: e.online ? { '@type': 'VirtualLocation', url: e.registration } : { '@type': 'Place', name: e.venue, address: e.locality },
  organizer: { '@type': 'Organization', name: 'ELIXIR-UK' },
};
---
<BaseLayout title={e.title} {jsonLd}>
  <PageHeader title={e.title} />
  <section class="event-page">
    <div class="container event-layout">
      <aside class="event-facts">
        <a class="tag" href={url(`/events/type/${tagSlug(e.type)}/`)}>{e.type}</a>
        <dl>
          <dt>When</dt><dd>{when}{time && <><br />{time}</>}</dd>
          {where && <><dt>Where</dt><dd>{where}</dd></>}
        </dl>
        {!isPast && e.registration && <a class="btn" href={e.registration} rel="noopener">Register</a>}
        {e.recording && <a class="btn btn--navy" href={e.recording} rel="noopener">Watch the recording</a>}
        {e.slides && <a class="btn btn--navy" href={e.slides} rel="noopener">Slides</a>}
      </aside>
      <div class="event-main">
        <div class="prose"><Content /></div>
        <div class="event-related"><SmartTabs kind="events" slug={entry.id} /></div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .event-page { padding-block: 3rem 5rem; }
  .event-layout { display: grid; grid-template-columns: 1fr 320px; gap: 3rem; align-items: start; }
  .event-main { grid-column: 1; grid-row: 1; }
  .event-facts {
    grid-column: 2;
    display: grid;
    gap: 1rem;
    justify-items: start;
    background: var(--grey-light);
    border-radius: 10px;
    padding: 1.75rem;
    position: sticky;
    top: 90px;
  }
  .event-facts dl { margin: 0; }
  .event-facts dt { font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--orange); }
  .event-facts dd { margin: 0.2rem 0 1.2rem; color: var(--navy); }
  .event-facts .btn { width: 100%; text-align: center; }
  .btn--navy { background: var(--navy); }
  .event-related { margin-top: 3rem; }
  /* On phones, date and registration come first */
  @media (max-width: 860px) {
    .event-layout { grid-template-columns: 1fr; gap: 2rem; }
    .event-facts { grid-column: 1; grid-row: 1; position: static; }
    .event-main { grid-row: 2; }
  }
</style>
