---
import Crumbs from '../../components/Crumbs.astro';
import { cleanHtml } from '../../lib/html';
// Event page – B2: navy header over the event image, date card inside the header
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RemoteImage from '../../components/RemoteImage.astro';
import Avatar from '../../components/Avatar.astro';
import PersonLine from '../../components/PersonLine.astro';
import SmartTabs from '../../components/SmartTabs.astro';
import { longDate, todayUK, firstSentence, needsStop } from '../../lib/format';
import { DIRECTORY, tagSlug, linksFor, shownLinks } from '../../lib/graph';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const events = await getCollection('events');
  return events.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
await render(entry);
const html = await cleanHtml(entry.rendered?.html ?? '');
const e = entry.data;
const today = todayUK();
const isPast = (e.end ?? e.start) < today;
const multi = e.end && e.end.getTime() !== e.start.getTime();
const when = multi ? `${longDate(e.start)} – ${longDate(e.end!)}` : longDate(e.start);
const time = e.startTime ? `${e.startTime}${e.endTime ? `–${e.endTime}` : ''} UK time` : undefined;
const FORMAT = { online: 'Online', 'in-person': 'In person', hybrid: 'Hybrid – in person and online' } as const;
const formatLabel = FORMAT[e.format];
const place = [e.venue, e.street, e.locality, e.postcode].filter(Boolean).join(', ');
// Online events have no "where"; in-person and hybrid events show the venue
const where = e.format === 'online' ? undefined : place || undefined;
const cost = e.cost > 0 ? new Intl.NumberFormat('en-GB', { style: 'currency', currency: e.currency, maximumFractionDigits: 0 }).format(e.cost) : 'Free';
const cancelled = e.status === 'cancelled';
// ISO date-time in UK time, with the right offset for GMT/BST
const iso = (d: Date, t?: string) => {
  if (!t) return d.toISOString().slice(0, 10);
  const probe = new Date(`${d.toISOString().slice(0, 10)}T${t}:00Z`);
  const london = new Date(probe.toLocaleString('en-US', { timeZone: 'Europe/London' }));
  const utc = new Date(probe.toLocaleString('en-US', { timeZone: 'UTC' }));
  const off = Math.round((london.getTime() - utc.getTime()) / 3600000);
  return `${d.toISOString().slice(0, 10)}T${t}:00+0${off}:00`;
};
const speakers = (await getCollection('people')).filter((p) => p.data.wpId && e.speakerIds.includes(p.data.wpId));
const isCall = e.type === 'Community Call';
const cta = isCall ? 'Join in' : 'Register';
const day = e.start.toLocaleDateString('en-GB', { day: 'numeric', timeZone: 'Europe/London' });
const month = e.start.toLocaleDateString('en-GB', { month: 'short', timeZone: 'Europe/London' });
const weekday = e.start.toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/London' });

const links = await shownLinks('events', entry.id, e.display);
const orgNode = links.activities?.[0];
const org = orgNode ? DIRECTORY.activities.records.find((r) => r.slug === orgNode.slug) : undefined;

const all = await getCollection('events');
const alsoComing = all
  .filter((x) => x.id !== entry.id && (x.data.end ?? x.data.start) >= today)
  .sort((a, b) => a.data.start.getTime() - b.data.start.getTime())
  .slice(0, 3);

// Google Calendar link (all-day if no time)
const ymd = (d: Date) => d.toISOString().slice(0, 10).replaceAll('-', '');
const hm = (t?: string) => (t ? t.replace(':', '').padEnd(4, '0') + '00' : '');
const calDates = e.startTime
  ? `${ymd(e.start)}T${hm(e.startTime)}/${ymd(e.end ?? e.start)}T${hm(e.endTime ?? e.startTime)}`
  : `${ymd(e.start)}/${ymd(new Date((e.end ?? e.start).getTime() + 86400000))}`;
const calUrl = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent(e.title)}&dates=${calDates}&ctz=Europe/London${where ? `&location=${encodeURIComponent(where)}` : ''}`;

const virtual = { '@type': 'VirtualLocation', url: e.registration ?? `https://elixiruknode.org/events/${entry.id}/` };
const physical = { '@type': 'Place', name: e.venue || e.locality, address: { '@type': 'PostalAddress', streetAddress: e.street, addressLocality: e.locality, postalCode: e.postcode, addressCountry: e.country || 'GB' } };
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: e.title,
  description: e.standfirst || html.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim().slice(0, 300),
  image: e.image ? [e.image] : undefined,
  startDate: iso(e.start, e.startTime),
  endDate: iso(e.end ?? e.start, e.endTime ?? e.startTime),
  eventStatus: `https://schema.org/${cancelled ? 'EventCancelled' : e.status === 'rescheduled' ? 'EventRescheduled' : 'EventScheduled'}`,
  eventAttendanceMode: `https://schema.org/${e.format === 'online' ? 'OnlineEventAttendanceMode' : e.format === 'hybrid' ? 'MixedEventAttendanceMode' : 'OfflineEventAttendanceMode'}`,
  location: e.format === 'online' ? virtual : e.format === 'hybrid' ? [physical, virtual] : physical,
  offers: { '@type': 'Offer', price: e.cost, priceCurrency: e.currency, url: e.registration, availability: `https://schema.org/${isPast || cancelled ? 'SoldOut' : 'InStock'}`, validFrom: undefined },
  organizer: { '@type': 'Organization', name: 'ELIXIR-UK', url: 'https://elixiruknode.org' },
  performer: speakers.length ? speakers.map((p) => ({ '@type': 'Person', name: p.data.name })) : undefined,
};
---
<BaseLayout title={e.title} description={e.standfirst} {jsonLd}>
  <section class="ev-hero">
    {e.image && <RemoteImage class="ev-hero__img" src={e.image} width={1600} loading="eager" />}
    <div class="ev-hero__shade"></div>
    <div class="container ev-hero__grid">
      <div>
        <Crumbs dark items={[{ label: 'Events', href: '/events/' }, { label: e.title }]} />
        <div class="ev-tags">
          <a class="pill" href={url(`/events/type/${tagSlug(e.type)}/`)}>{e.type}</a>
          {org && <a class="pill" href={url(`/activities/${org.slug}/`)}>{org.name}</a>}
          <span class="pill pill--format">{formatLabel}</span>
          {cancelled && <span class="pill pill--cancel">Cancelled</span>}
          {isPast && !cancelled && <span class="pill">Past event</span>}
        </div>
        <h1 class="display ev-title">{e.title}{needsStop(e.title) && <span class="stop">.</span>}</h1>
        {e.standfirst && <p class="ev-stand">{e.standfirst}</p>}
      </div>
      <div class="ev-card">
        <div class="ev-card__date"><span>{month}</span><strong>{day}</strong></div>
        <div class="ev-card__body">
          <p class="ev-card__when">{multi ? when : weekday}</p>
          {time && <p>{time}</p>}
          <p>{e.format === 'online' ? 'Online' : where ? `${where}${e.format === 'hybrid' ? ' and online' : ''}` : formatLabel}</p>
          <p>{cost}</p>
        </div>
        <div class="ev-card__actions">
          {!isPast && !cancelled && e.registration && <a class="btn" href={e.registration} rel="noopener">{cta}</a>}
          {!isPast && !cancelled && <a class="btn btn--line" href={calUrl} rel="noopener">Add to calendar</a>}
          {e.programme && <a class="btn btn--line" href={e.programme} rel="noopener">Programme</a>}
          {cancelled && <p class="ev-card__note">This event has been cancelled.</p>}
          {e.recording && <a class="btn" href={e.recording} rel="noopener">Watch the recording</a>}
          {e.slides && <a class="btn btn--line" href={e.slides} rel="noopener">Slides</a>}
          {isPast && !e.recording && !e.slides && <p class="ev-card__note">This event has finished.</p>}
        </div>
      </div>
    </div>
  </section>

  <section class="container ev-body">
    <div>
      <div class="prose" set:html={html} />
      <dl class="ev-facts">
        <div><dt>Date</dt><dd>{when}</dd></div>
        {time && <div><dt>Time</dt><dd>{time}</dd></div>}
        <div><dt>Format</dt><dd>{formatLabel}</dd></div>
        {where && <div><dt>Where</dt><dd>{where}</dd></div>}
        <div><dt>Cost</dt><dd>{cost}</dd></div>
      </dl>
    </div>
    <aside class="ev-side">
      {speakers.length > 0 && (
        <div class="ev-box">
          <p class="eyebrow-sm">{speakers.length === 1 ? 'Speaker' : 'Speakers'}</p>
          <ul class="ev-people">{speakers.map((p) => <li><PersonLine p={p} size={48} ring="var(--grey-light)" /></li>)}</ul>
        </div>
      )}
      {org && (
        <a class="ev-org" href={url(`/activities/${org.slug}/`)}>
          <span class="eyebrow-sm">Organised by</span>
          <span class="ev-org__row">
            {org.logo && <Avatar src={org.logo} name={org.name} size={64} logo ring="var(--grey-light)" />}
            <strong>{org.name}</strong>
          </span>
          {org.summary && <span class="ev-org__sum">{firstSentence(org.summary)}</span>}
          <span class="ev-org__go">{org.joinLink ? 'Find out how to join →' : 'About this community →'}</span>
        </a>
      )}
    </aside>
  </section>

  <section class="container ev-related"><SmartTabs kind="events" slug={entry.id} display={e.display} skip={['people']} heading="Related" /></section>

  {alsoComing.length > 0 && (
    <section class="ev-more">
      <div class="container">
        <h2 class="section-title">Also coming up<span class="stop">.</span></h2>
        <div class="ev-more__grid">
          {alsoComing.map((x) => (
            <a class="ev-more__item lift" href={url(`/events/${x.id}/`)}>
              <span class="ev-more__date">{longDate(x.data.start)}</span>
              <strong>{x.data.title}</strong>
              <span class="ev-more__type">{x.data.type}{x.data.online ? ' · Online' : ''}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .ev-hero { position: relative; overflow: hidden; background: var(--ink); color: var(--white); }
  .ev-hero :global(.ev-hero__img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: grayscale(1); }
  .ev-hero__shade { position: absolute; inset: 0; background: rgba(1, 29, 49, 0.84); }
  .ev-hero__grid { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) 380px; gap: 56px; align-items: center; padding-block: 56px 72px; }
  .ev-stand { margin: var(--s4) 0 0; max-width: 40rem; font-size: var(--fs-lead); color: var(--on-dark); }
  .pill--format { background: rgb(255 255 255 / 0.14); }
  .pill--cancel { background: #b3261e; }
  .ev-box { padding: var(--s5); border-radius: var(--radius-lg); background: var(--grey-light); margin-bottom: var(--s4); }
  .ev-people { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .ev-tags { display: flex; gap: 8px; flex-wrap: wrap; }
  .ev-title { font-size: clamp(2.2rem, 4.6vw, 3.6rem); margin: 18px 0 0; color: var(--white); }
  .ev-card { background: var(--white); color: var(--text); border-radius: 12px; padding: 28px; display: grid; grid-template-columns: auto 1fr; gap: 20px 22px; box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3); }
  .ev-card__date { display: grid; place-items: center; width: 84px; height: 92px; border-radius: 10px; background: var(--orange); color: var(--on-orange); }
  .ev-card__date span { font-size: 14px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; }
  .ev-card__date strong { font-size: 40px; font-weight: 900; line-height: 1; }
  .ev-card__body p { margin: 0 0 4px; font-size: 15px; }
  .ev-card__when { font-weight: 700; color: var(--navy); font-size: 17px !important; }
  .ev-card__actions { grid-column: 1 / -1; display: grid; gap: 10px; }
  .ev-card__actions .btn { text-align: center; }
  .ev-card__note { margin: 0; font-size: 15px; color: var(--muted); }
  .ev-body { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 64px; padding-block: 72px 32px; }
  .ev-facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 20px; margin: 40px 0 0; padding: 24px 0; border-block: 1px solid var(--border); }
  .ev-facts dt { font-size: var(--fs-sm); font-weight: 700; letter-spacing: 0;  color: var(--orange-text); }
  .ev-facts dd { margin: 4px 0 0; color: var(--navy); font-weight: 600; }
  .ev-org { display: grid; gap: 12px; padding: 28px; border-radius: 10px; background: var(--grey-light); color: var(--text); }
  .ev-org:hover { color: var(--text); background: #e8eef2; }
  .ev-org__row { display: flex; align-items: center; gap: 14px; color: var(--navy); font-size: 1.15rem; }
  .ev-org__sum { font-size: 15px; }
  .ev-org__go { font-weight: 700; color: var(--blue); }
  .ev-related { padding-block: 40px 72px; }
  .ev-more { background: var(--grey-light); padding-block: 72px; }
  .ev-more__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin-top: 28px; }
  .ev-more__item { display: grid; gap: 8px; padding: 24px; border-radius: 10px; background: var(--white); color: var(--navy); }
  .ev-more__date { font-size: 13px; font-weight: 700; color: var(--orange-text); }
  .ev-more__type { font-size: 14px; color: var(--muted); }
  @media (max-width: 900px) {
    .ev-hero__grid, .ev-body { grid-template-columns: 1fr; gap: 32px; }
    .ev-more__grid { grid-template-columns: 1fr; }
  }
</style>
