---
// Vertical bars, one series. Value labels on every bar (few bars), rounded tops, 2px gaps.
interface Props { data: { label: string; value: number; note?: string }[]; theme?: 'dark' | 'light'; title: string }
const { data, theme = 'dark', title } = Astro.props;
const W = 320, H = 200, padT = 30, padB = 28, gap = 14;
const max = Math.max(...data.map((d) => d.value), 1);
const bw = (W - gap * (data.length - 1)) / data.length;
const h = (v: number) => (H - padT - padB) * (v / max);
---
<figure class:list={['bchart', `bchart--${theme}`]}>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`${title}: ${data.map((d) => `${d.label} ${d.value}`).join(', ')}`}>
    <defs><pattern id="hatch" width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><rect width="8" height="8" fill="var(--orange)" opacity="0.25" /><line x1="0" y1="0" x2="0" y2="8" stroke="var(--orange)" stroke-width="3" /></pattern></defs>
    <line class="base" x1="0" x2={W} y1={H - padB} y2={H - padB} />
    {data.map((d, i) => {
      const x = i * (bw + gap), bh = h(d.value), y = H - padB - bh;
      return (
        <g>
          <path class:list={['bar', { 'bar--partial': d.note }]} d={`M${x},${H - padB} V${y + 4} Q${x},${y} ${x + 4},${y} H${x + bw - 4} Q${x + bw},${y} ${x + bw},${y + 4} V${H - padB} Z`} />
          <text class="val" x={x + bw / 2} y={y - 8} text-anchor="middle">{d.value}</text>
          <text class="lbl" x={x + bw / 2} y={H - 8} text-anchor="middle">{d.label}{d.note ? '*' : ''}</text>
        </g>
      );
    })}
  </svg>
  {data.some((d) => d.note) && <figcaption>* {data.find((d) => d.note)!.note}</figcaption>}
</figure>
<style>
  .bchart { margin: 0; }
  svg { width: 100%; height: auto; display: block; overflow: visible; }
  .bar { fill: var(--orange); }
  .bar--partial { fill: url(#hatch); stroke: var(--orange); stroke-width: 2; }
  .val { font: 900 18px var(--font); }
  .lbl { font: 400 12px var(--font); }
  .bchart--dark .val { fill: var(--white); }
  .bchart--dark .lbl, .bchart--dark figcaption { fill: #8fa9bc; color: #8fa9bc; }
  .bchart--dark .base { stroke: rgb(255 255 255 / 0.2); }
  .bchart--light .val { fill: var(--navy); }
  .bchart--light .lbl, .bchart--light figcaption { fill: var(--muted); color: var(--muted); }
  .bchart--light .base { stroke: var(--border); }
  figcaption { font-size: 13px; margin-top: 6px; }
</style>
