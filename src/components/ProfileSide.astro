---
// Sidebar content shared by people and organisation profiles
import RemoteImage from './RemoteImage.astro';

interface Fact { label: string; value: string; href?: string }
interface Props {
  name: string;
  subtitle?: string;
  image?: string;
  round?: boolean;          // people: round photo; organisations: logo on a white card
  pills?: { heading: string; items: string[] };
  facts?: Fact[];
  links?: { label: string; href: string }[];
}
const { name, subtitle, image, round = false, pills, facts = [], links = [] } = Astro.props;
const initials = name.split(/\s+/).map((w) => w[0]).join('').slice(0, 2);
---
<div class:list={['side-media', { 'side-media--round': round }]} data-reveal="zoom-in">
  {image ? <RemoteImage src={image} width={round ? 400 : 360} alt={round ? '' : `${name} logo`} loading="eager" /> : <span class="side-initials">{initials}</span>}
</div>
<h1 class="side-name" data-reveal="fade-up">{name}</h1>
{subtitle && <p class="side-subtitle">{subtitle}</p>}

{pills && pills.items.length > 0 && (
  <div class="side-block">
    <p class="side-heading">{pills.heading}</p>
    <ul class="side-pills">{pills.items.map((p) => <li>{p}</li>)}</ul>
  </div>
)}

{facts.length > 0 && (
  <dl class="side-block side-facts">
    {facts.map((f) => <div><dt>{f.label}</dt><dd>{f.href ? <a href={f.href}>{f.value}</a> : f.value}</dd></div>)}
  </dl>
)}

{links.length > 0 && (
  <div class="side-block side-links">
    <p class="side-heading">Contact info</p>
    {links.map((l) => <a href={l.href} rel="noopener">{l.label}</a>)}
  </div>
)}
<slot />

<style>
  .side-media {
    display: grid;
    place-items: center;
    width: 100%;
    max-width: 260px;
    aspect-ratio: 1;
    padding: 1.5rem;
    background: var(--white);
    border-radius: 12px;
  }
  .side-media :global(img) { max-width: 100%; max-height: 100%; object-fit: contain; }
  .side-media--round {
    max-width: 200px;
    padding: 0;
    border-radius: 50%;
    overflow: hidden;
    background: rgb(2 52 82 / 0.11);
    box-shadow: 0 20px 40px rgb(2 52 82 / 0.12);
  }
  .side-media--round :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .side-initials { font-size: 3rem; font-weight: 900; color: var(--navy); }
  .side-name { font-size: clamp(1.6rem, 2.4vw, 2rem); margin: 0; }
  .side-subtitle { margin: -0.75rem 0 0; color: var(--text); }
  .side-block { width: 100%; text-align: left; }
  .side-heading { font-size: 12px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text); margin-bottom: 0.5rem; font-weight: 700; }
  .side-pills { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; margin: 0; padding: 0; }
  .side-pills li { font-size: 12px; padding: 0.2rem 0.6rem; background: var(--blue); color: var(--white); border-radius: 3px; }
  .side-facts { margin: 0; display: grid; gap: 0.75rem; }
  .side-facts dt { font-size: 12px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--orange); font-weight: 700; }
  .side-facts dd { margin: 0.1rem 0 0; color: var(--navy); }
  .side-links { display: flex; flex-direction: column; gap: 0.35rem; font-size: 14px; }
</style>
