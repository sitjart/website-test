---
// UK members map: outline traced from the live site's map-members.svg, one dot per city.
// Dots link to the member page; cities with several members open a small list.
// Locations live in src/data/member-locations.json until they move to Baserow.
import outline from '../data/geo/uk-outline.txt?raw';
import locations from '../data/member-locations.json';
import { DIRECTORY } from '../lib/graph';
import { project } from '../lib/geo';
import { url } from '../lib/url';

interface Props { label?: string; class?: string; highlight?: string; theme?: 'dark' | 'light'; interactive?: boolean; filter?: boolean }
const { label = 'Map of ELIXIR-UK member organisations across the UK', class: className, highlight, theme = 'dark', interactive = true, filter = false } = Astro.props;
const members = DIRECTORY.members.records;
type Loc = { city: string; lat: number; lon: number };
const locs = locations as Record<string, Loc>;
const cities = new Map<string, { x: number; y: number; members: { slug: string; name: string }[] }>();
for (const m of members) {
  const l = locs[m.slug];
  if (!l) continue;
  const p = project(l.lat, l.lon);
  const c = cities.get(l.city) ?? { ...p, members: [] };
  c.members.push({ slug: m.slug, name: m.name });
  cities.set(l.city, c);
}
const list = [...cities.entries()].sort((a, b) => a[1].y - b[1].y);
const hiCity = highlight ? locs[highlight]?.city : undefined;
const id = `map-${Math.random().toString(36).slice(2, 8)}`;
---
<figure class:list={['ukmap', `ukmap--${theme}`, className, { 'has-hi': hiCity }]} id={id} data-filter={filter ? '' : undefined}>
  <svg viewBox="0 0 633 1049" role={interactive ? 'group' : 'img'} aria-labelledby={`${id}-t`}>
    <title id={`${id}-t`}>{label}</title>
    <path class="ukmap__land" d={outline.trim()} />
    {list.map(([city, c], i) => {
      const n = c.members.length;
      const r = n > 1 ? 11 + Math.min(n, 6) * 2.2 : 10;
      const single = n === 1;
      const href = single ? url(`/members/${c.members[0].slug}/`) : undefined;
      const names = c.members.map((m) => m.name).join(', ');
      const isHi = city === hiCity;
      return interactive ? (
        <a href={href ?? `#${id}-${i}`} class:list={['ukmap__dot', { 'is-hi': isHi }]} data-city={city} data-i={i} aria-label={single ? `${c.members[0].name}, ${city}` : `${city}: ${n} members – ${names}`} style={`--i:${i}`}>
          <circle cx={c.x} cy={c.y} r={r + 14} class="ukmap__hit" />
          {isHi && <circle cx={c.x} cy={c.y} r={r + 16} class="ukmap__halo" />}
          <circle cx={c.x} cy={c.y} r={r} class="ukmap__pt" />
          {n > 1 && <text x={c.x} y={c.y + 6} text-anchor="middle">{n}</text>}
        </a>
      ) : (
        <g class:list={['ukmap__dot', { 'is-hi': isHi }]} style={`--i:${i}`}>
          {isHi && <circle cx={c.x} cy={c.y} r={r + 16} class="ukmap__halo" />}
          <circle cx={c.x} cy={c.y} r={r} class="ukmap__pt" />
        </g>
      );
    })}
  </svg>
  {interactive && (
    <div class="ukmap__pop" role="dialog" aria-live="polite" hidden></div>
  )}
  {interactive && (
    <template class="ukmap__data" set:html={JSON.stringify(list.map(([city, c]) => ({ city, x: c.x, y: c.y, members: c.members.map((m) => ({ name: m.name, slug: m.slug, href: url(`/members/${m.slug}/`) })) })))} />
  )}
</figure>

<script>
  document.querySelectorAll<HTMLElement>('.ukmap').forEach((fig) => {
    const tpl = fig.querySelector('template.ukmap__data');
    const pop = fig.querySelector<HTMLElement>('.ukmap__pop');
    const svg = fig.querySelector('svg');
    if (!tpl || !pop || !svg) return;
    const data = JSON.parse(tpl.innerHTML) as { city: string; x: number; y: number; members: { name: string; slug: string; href: string }[] }[];
    const filtering = fig.hasAttribute('data-filter');
    let pinned = false;
    const show = (i: number, pin = false) => {
      const d = data[i];
      const vb = svg.viewBox.baseVal;
      const box = svg.getBoundingClientRect();
      const fb = fig.getBoundingClientRect();
      const x = (d.x / vb.width) * box.width + box.left - fb.left;
      const y = (d.y / vb.height) * box.height + box.top - fb.top;
      pop.innerHTML = `<p class="ukmap__city">${d.city}</p>` + (d.members.length === 1
        ? `<a href="${d.members[0].href}">${d.members[0].name}</a>`
        : `<ul>${d.members.map((m) => `<li><a href="${m.href}">${m.name}</a></li>`).join('')}</ul>`);
      pop.style.left = `${x}px`;
      pop.style.top = `${y}px`;
      pop.classList.toggle('is-left', x > fb.width * 0.55);
      pop.hidden = false;
      pinned = pin;
    };
    const hide = () => { if (!pinned) pop.hidden = true; };
    fig.querySelectorAll<SVGAElement>('.ukmap__dot').forEach((a) => {
      const i = Number(a.dataset.i);
      const multi = data[i].members.length > 1;
      a.addEventListener('mouseenter', () => show(i));
      a.addEventListener('mouseleave', () => setTimeout(() => { if (!pop.matches(':hover') && !a.matches(':hover')) hide(); }, 400));
      a.addEventListener('focus', () => show(i));
      a.addEventListener('blur', () => setTimeout(() => { if (!pop.contains(document.activeElement)) { pinned = false; hide(); } }, 50));
      a.addEventListener('click', (e) => {
        if (filtering) {
          // On the members page a city filters the list instead of leaving the page
          e.preventDefault();
          fig.querySelectorAll('.ukmap__dot').forEach((d) => d.classList.toggle('is-picked', d === a));
          fig.dispatchEvent(new CustomEvent('ukmap:select', { bubbles: true, detail: { city: data[i].city, slugs: data[i].members.map((m) => m.slug) } }));
          show(i, true);
        } else if (multi) { e.preventDefault(); show(i, true); pop.querySelector('a')?.focus(); }
      });
    });
    pop.addEventListener('mouseleave', () => setTimeout(hide, 300));
    fig.addEventListener('ukmap:clear', () => { fig.querySelectorAll('.ukmap__dot').forEach((d) => d.classList.remove('is-picked')); pinned = false; pop.hidden = true; });
    document.addEventListener('click', (e) => { if (!fig.contains(e.target as Node)) { pinned = false; pop.hidden = true; } });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { pinned = false; pop.hidden = true; } });
  });
</script>

<style>
  .ukmap { position: relative; margin: 0; }
  svg { width: 100%; height: auto; display: block; overflow: visible; }
  .ukmap--dark .ukmap__land { fill: #0b3a5a; stroke: #1d5378; stroke-width: 1.5; }
  .ukmap--light .ukmap__land { fill: #dbe6ee; stroke: #c6d6e2; stroke-width: 1.5; }
  .ukmap__pt { fill: var(--orange); stroke-width: 3; transition: r 0.2s var(--ease), fill 0.2s; }
  .ukmap--dark .ukmap__pt { stroke: var(--ink); }
  .ukmap--light .ukmap__pt { stroke: var(--white); }
  .has-hi .ukmap__dot:not(.is-hi) .ukmap__pt { fill: #7a97ad; }
  .ukmap__halo { fill: none; stroke: var(--orange); stroke-width: 3; opacity: 0.5; }
  .ukmap__hit { fill: transparent; }
  .ukmap__dot text { font: 900 17px var(--font); fill: var(--white); pointer-events: none; }
  a.ukmap__dot { cursor: pointer; outline: none; }
  a.ukmap__dot:hover .ukmap__pt, a.ukmap__dot:focus-visible .ukmap__pt { fill: var(--white); }
  a.ukmap__dot:hover text, a.ukmap__dot:focus-visible text { fill: var(--navy); }
  a.ukmap__dot:focus-visible .ukmap__hit { stroke: var(--orange); stroke-width: 3; }
  .ukmap__dot { transform-box: fill-box; transform-origin: center; animation: pop 0.5s var(--ease) both; animation-delay: calc(var(--i) * 35ms + 250ms); }
  @keyframes pop { from { transform: scale(0); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .ukmap__dot { animation: none; } }
  a.ukmap__dot.is-picked .ukmap__pt { fill: var(--navy); }
  .ukmap--dark a.ukmap__dot.is-picked .ukmap__pt { fill: var(--white); }
  .ukmap__pop::before { content: ''; position: absolute; left: -18px; top: 0; bottom: 0; width: 18px; }
  .ukmap__pop.is-left::before { left: auto; right: -18px; }
  .ukmap__pop { position: absolute; z-index: 5; transform: translate(18px, -50%); min-width: 200px; max-width: 280px; padding: 14px 16px; background: var(--white); color: var(--text); border-radius: 8px; box-shadow: 0 12px 32px rgb(0 0 0 / 0.25); font-size: 14px; line-height: 1.35; }
  .ukmap__pop.is-left { transform: translate(calc(-100% - 18px), -50%); }
  .ukmap__pop :global(.ukmap__city) { margin: 0 0 6px; font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--orange-text); }
  .ukmap__pop :global(ul) { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .ukmap__pop :global(a) { font-weight: 700; color: var(--navy); }
  .ukmap__pop :global(a:hover) { color: var(--orange-text); }
</style>
