---
// "Smart tabs", rebuilt from the live profile pages: one tab per kind of linked record,
// empty tabs are dropped, and the tab bar only appears when there is more than one tab.
// Without JavaScript, all panels show one after another.
import { shownLinks, LABELS, TAB_ORDER, type Kind, type Display } from '../lib/graph';
import RelatedCards from './RelatedCards.astro';
import { cardsFor } from '../lib/lookup';
import { url } from '../lib/url';

interface Props { kind: Kind; slug: string; bioLabel?: string; hasBio?: boolean; skip?: Kind[]; heading?: string; display?: Display }
const { kind, slug, bioLabel = 'Bio', hasBio = false, skip = [], heading, display } = Astro.props;
const groups = await shownLinks(kind, slug, display);
skip.forEach((k) => delete groups[k]);
const panels = [
  ...(hasBio ? [{ id: 'bio', label: bioLabel }] : []),
  ...TAB_ORDER.filter((k) => groups[k]?.length).map((k) => ({ id: k, label: LABELS[k] })),
];
const uid = `tabs-${kind}-${slug}`;
const LIMIT = 6;
const cards = Object.fromEntries(await Promise.all(TAB_ORDER.filter((k) => groups[k]?.length).map(async (k) => [k, await cardsFor(k, groups[k]!.map((n) => n.slug))])));
const dotColour: Record<string, string> = { news: '#047eaa', events: '#f47d21', projects: '#023452', services: '#8fb3c9', activities: '#6e9fb8', members: '#023452', people: '#f47d21', collaborations: '#8fb3c9', area: '#047eaa' };
const when = (n: { date?: Date; label?: string }) => n.date ? n.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }) : '';
---
{panels.length > 0 && (
  <div class="smart-tabs" data-smart-tabs>
    {heading && <h2 class="section-title smart-tabs__h">{heading}<span class="stop">.</span></h2>}
    {panels.length > 1 && (
      <nav class="smart-tabs-nav" role="tablist">
        {panels.map((p, i) => (
          <button type="button" role="tab" class:list={['smart-tab-btn', { active: i === 0 }]} id={`${uid}-tab-${p.id}`}
            aria-controls={`${uid}-${p.id}`} aria-selected={i === 0 ? 'true' : 'false'} data-tab={p.id}>{p.label}{p.id !== 'bio' && <span class="smart-tab-count">{groups[p.id as Kind]!.length}</span>}</button>
        ))}
      </nav>
    )}
    {panels.map((p, i) => (
      <div class:list={['tab-panel', { active: i === 0 }]} id={`${uid}-${p.id}`} role="tabpanel" aria-labelledby={`${uid}-tab-${p.id}`} data-panel={p.id}>
        {p.id === 'bio' ? <slot /> : <RelatedCards cards={cards[p.id]} limit={LIMIT} />}
      </div>
    ))}
  </div>
)}

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-more]').forEach((b) => b.addEventListener('click', () => {
    b.previousElementSibling?.querySelectorAll<HTMLElement>('[data-extra]').forEach((li) => (li.hidden = false));
    b.remove();
  }));
  document.querySelectorAll<HTMLElement>('[data-smart-tabs]').forEach((box) => {
    const buttons = box.querySelectorAll<HTMLButtonElement>('.smart-tab-btn');
    if (!buttons.length) return;
    box.classList.add('is-enhanced');
    const show = (id: string) => {
      buttons.forEach((b) => {
        const on = b.dataset.tab === id;
        b.classList.toggle('active', on);
        b.setAttribute('aria-selected', String(on));
        b.tabIndex = on ? 0 : -1;
      });
      box.querySelectorAll<HTMLElement>('.tab-panel').forEach((p) => p.classList.toggle('active', p.dataset.panel === id));
    };
    buttons.forEach((b, i) => {
      b.addEventListener('click', () => show(b.dataset.tab!));
      b.addEventListener('keydown', (e) => {
        const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!step) return;
        const next = buttons[(i + step + buttons.length) % buttons.length];
        next.focus();
        show(next.dataset.tab!);
      });
    });
  });
</script>

<style>
  .smart-tabs__h { margin-bottom: var(--s5); }
  /* Tab styles taken from the live site's custom CSS (.smart-tabs-nav / .smart-tab-btn) */
  .smart-tabs-nav {
    display: flex;
    flex-wrap: wrap;
    border-bottom: 2px solid var(--border);
    margin-bottom: 1.5rem;
  }
  .smart-tab-btn {
    font-family: var(--font);
    font-size: var(--fs-base);
    font-weight: 700;
    letter-spacing: 0;
    color: var(--text);
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 0.6rem 1rem;
    margin-bottom: -2px;
    cursor: pointer;
    white-space: nowrap;
    transition: color 160ms ease;
  }
  .smart-tab-btn:hover { color: var(--blue); }
  .smart-tab-btn.active { color: var(--navy); border-bottom-color: var(--blue); font-weight: 700; }
  .smart-tabs.is-enhanced .tab-panel { display: none; }
  .smart-tabs.is-enhanced .tab-panel.active { display: block; animation: tab-in 0.25s var(--ease); }
  @keyframes tab-in { from { opacity: 0; transform: translateY(6px); } }

  .smart-tab-count { margin-left: 6px; opacity: 0.6; font-weight: 400; }
  .tab-list { list-style: none; margin: 0; padding: 0; }
  .tab-item { display: grid; grid-template-columns: 110px 24px minmax(0, 1fr); gap: 0 20px; }
  .tab-item[hidden] { display: none; }
  .tab-item__when { font-size: 14px; font-weight: 700; color: var(--navy); text-align: right; padding-top: 2px; }
  .tab-item__dot { position: relative; display: flex; justify-content: center; }
  .tab-item__dot::before { content: ''; position: absolute; top: 0; bottom: 0; width: 2px; background: var(--border); }
  .tab-item__dot::after { content: ''; position: relative; margin-top: 6px; width: 14px; height: 14px; border-radius: 50%; background: var(--dot); border: 3px solid var(--white); box-shadow: 0 0 0 1px var(--dot); }
  .tab-item a { display: flex; flex-direction: column; gap: 2px; padding-bottom: 26px; color: var(--text); }
  .tab-item__meta { font-size: var(--fs-sm); font-weight: 700; letter-spacing: 0;  color: var(--orange-text); }
  .tab-item__title { font-size: 1.2rem; line-height: 1.3; font-weight: 700; color: var(--navy); transition: color 0.2s var(--ease); }
  .tab-item a:hover .tab-item__title { color: var(--blue); }
  .tab-item__summary { font-size: 0.9rem; line-height: 1.5; }
  .tab-more { margin: 8px 0 0 154px; font: inherit; font-weight: 700; color: var(--blue); background: none; border: 0; cursor: pointer; padding: 0; }
  @media (max-width: 600px) {
    .tab-item { grid-template-columns: 16px minmax(0, 1fr); gap: 0 14px; }
    .tab-item__when { grid-column: 2; text-align: left; padding: 0; }
    .tab-item__dot { grid-row: 1 / span 2; grid-column: 1; }
    .tab-item a { grid-column: 2; }
    .tab-more { margin-left: 30px; }
  }
  @media (prefers-reduced-motion: reduce) { .smart-tabs.is-enhanced .tab-panel.active { animation: none; } }
</style>
