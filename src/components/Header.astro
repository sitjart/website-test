---
// Site header with mega menu (in the spirit of turing.ac.uk and crick.ac.uk):
// each section opens a full-width panel with an intro, grouped links and a live feature
// (next events, latest stories, members map). Panels open on click or hover, close on Escape.
// On small screens the menu becomes stacked accordions.
import { getCollection } from 'astro:content';
import nav from '../data/navigation.json';
import UkMap from './UkMap.astro';
import RemoteImage from './RemoteImage.astro';
import { DIRECTORY } from '../lib/graph';
import { localAsset } from '../lib/assets';
import { longDate, todayUK } from '../lib/format';
import { url } from '../lib/url';

interface Props { overlay?: boolean }
const { overlay = false } = Astro.props;
const current = Astro.url.pathname;
type Item = (typeof nav)[number] & { mega?: { intro: string; cta: { label: string; href: string }; columns: { heading: string; links: { label: string; href: string; desc?: string }[] }[]; feature?: string }; cta?: boolean };
const items = nav as Item[];
const inSection = (item: Item) =>
  [item.href, ...(item.mega?.columns.flatMap((c) => c.links.map((l) => l.href)) ?? [])].some((h) => h !== '/' && current.startsWith(url(h)));

const today = todayUK();
const nextEvents = (await getCollection('events')).filter((e) => (e.data.end ?? e.data.start) >= today).sort((a, b) => a.data.start.getTime() - b.data.start.getTime()).slice(0, 3);
const latest = (await getCollection('news')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 3);
const memberCount = DIRECTORY.members.records.length;
const clubs = DIRECTORY.activities.records.filter((a) => a.tags.includes('Club'));
const f = (d: Date, o: Intl.DateTimeFormatOptions) => d.toLocaleDateString('en-GB', { ...o, timeZone: 'UTC' });
---
<header class:list={['site-header', { 'site-header--overlay': overlay }]} data-header>
  <div class="container site-header__inner">
    <a class="site-header__logo" href={url('/')}>
      <img src={url('/images/elixir-uk-logo.svg')} alt="ELIXIR United Kingdom – home" width="112" height="38" />
    </a>

    <a class="site-header__search" href={url('/search/')} aria-label="Search">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M15.5 15.5 21 21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    </a>
    <button class="site-header__toggle" aria-expanded="false" aria-controls="primary-nav" data-nav-toggle>
      <span class="visually-hidden">Menu</span>
      <span aria-hidden="true"></span>
    </button>

    <nav id="primary-nav" class="site-nav" aria-label="Main">
      <ul class="site-nav__list">
        {items.map((item, i) => (
          <li class:list={['site-nav__item', { 'is-cta': item.cta, 'is-section': inSection(item), 'has-mega': item.mega }]}>
            {item.mega && item.mega.columns.length === 0 && (
              <a class="site-nav__top site-nav__mobile-link" href={url(item.href)}>{item.label}</a>
            )}
            {item.mega ? (
              <button type="button" class:list={['site-nav__top', { 'site-nav__desktop-only': item.mega.columns.length === 0 }]} aria-expanded="false" aria-controls={`mega-${i}`} data-mega-btn>
                {item.label}
                <svg class="chevron" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
              </button>
            ) : (
              <a class="site-nav__top" href={url(item.href)} aria-current={current === url(item.href) ? 'page' : undefined}>{item.label}</a>
            )}
            {item.mega && (
              <div class="mega" id={`mega-${i}`} data-mega>
                <div class="container mega__grid">
                  <div class="mega__intro">
                    <p class="mega__title">{item.label}<span class="stop">.</span></p>
                    <p>{item.mega.intro}</p>
                    <a class="more-link" href={url(item.mega.cta.href)}>{item.mega.cta.label}</a>
                  </div>
                  {item.mega.columns.map((col) => (
                    <div class="mega__col">
                      <p class="mega__heading">{col.heading}</p>
                      <ul>
                        {col.links.map((l) => (
                          <li><a href={url(l.href)} aria-current={current === url(l.href) ? 'page' : undefined}>
                            <span class="mega__link">{l.label}</span>
                            {l.desc && <span class="mega__desc">{l.desc}</span>}
                          </a></li>
                        ))}
                      </ul>
                    </div>
                  ))}
                  {item.mega.feature === 'events' && (
                    <div class="mega__feature mega__feature--wide">
                      <p class="mega__heading">Coming up</p>
                      <ul class="mega__events">
                        {nextEvents.map((e) => (
                          <li><a href={url(`/events/${e.id}/`)}>
                            <span class="mega__date"><b>{f(e.data.start, { day: 'numeric' })}</b>{f(e.data.start, { month: 'short' })}</span>
                            <span><span class="mega__desc">{e.data.type} · {e.data.format === 'in-person' ? 'In person' : e.data.format === 'hybrid' ? 'Hybrid' : 'Online'}</span><span class="mega__link">{e.data.title}</span></span>
                          </a></li>
                        ))}
                      </ul>
                    </div>
                  )}
                  {item.mega.feature === 'news' && (
                    <div class="mega__feature mega__feature--news">
                      {latest.map((n) => (
                        <a class="mega__story" href={url(`/news/${n.id}/`)}>
                          <span class="mega__img">{n.data.image && <RemoteImage src={n.data.image} width={360} />}</span>
                          <span class="mega__desc">{n.data.category} · {longDate(n.data.date)}</span>
                          <span class="mega__link">{n.data.title}</span>
                        </a>
                      ))}
                    </div>
                  )}
                  {item.mega.feature === 'clubs' && (
                    <div class="mega__feature mega__clubs">
                      <p class="mega__heading">ELIXIR-UK Clubs</p>
                      <ul>{clubs.map((c) => (
                        <li><a href={url(`/activities/${c.slug}/`)}>
                          <span class="icon-disc">{c.logo ? <img src={localAsset(c.logo)} alt="" /> : <b>{c.name[0]}</b>}</span>
                          <span class="mega__link">{c.name}</span>
                        </a></li>
                      ))}</ul>
                    </div>
                  )}
                  {item.mega.feature === 'members' && (
                    <a class="mega__feature mega__map" href={url('/members/')}>
                      <UkMap interactive={false} label="Map of ELIXIR-UK members" />
                      <span><b>{memberCount}</b> member organisations across the UK</span>
                    </a>
                  )}
                </div>
              </div>
            )}
          </li>
        ))}
      </ul>
    </nav>
  </div>
  <div class="mega-scrim" data-mega-scrim hidden></div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const onScroll = () => header.classList.toggle('is-stuck', window.scrollY > 40);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    header.classList.toggle('nav-open', !open);
  });

  const desktop = matchMedia('(min-width: 1025px)');
  const btns = [...header.querySelectorAll<HTMLButtonElement>('[data-mega-btn]')];
  const scrim = header.querySelector<HTMLElement>('[data-mega-scrim]')!;
  let closeTimer = 0;
  const setOpen = (btn: HTMLButtonElement | null) => {
    btns.forEach((b) => {
      const on = b === btn;
      b.setAttribute('aria-expanded', String(on));
      b.closest('li')?.classList.toggle('is-open', on);
    });
    scrim.hidden = !btn || !desktop.matches;
    header.classList.toggle('mega-open', !!btn);
  };
  btns.forEach((b) => {
    const li = b.closest('li')!;
    b.addEventListener('click', () => setOpen(b.getAttribute('aria-expanded') === 'true' ? null : b));
    // Hover intent on desktop: open after a short pause, close after leaving the item and its panel
    let openTimer = 0;
    li.addEventListener('mouseenter', () => { if (!desktop.matches) return; clearTimeout(closeTimer); openTimer = window.setTimeout(() => setOpen(b), 120); });
    li.addEventListener('mouseleave', () => { if (!desktop.matches) return; clearTimeout(openTimer); closeTimer = window.setTimeout(() => setOpen(null), 220); });
  });
  scrim.addEventListener('click', () => setOpen(null));
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const open = btns.find((b) => b.getAttribute('aria-expanded') === 'true');
    if (open) { setOpen(null); open.focus(); }
    else if (header.classList.contains('nav-open')) { toggle?.click(); toggle?.focus(); }
  });
  header.addEventListener('focusout', (e) => { if (desktop.matches && !header.contains(e.relatedTarget as Node)) setOpen(null); });
</script>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: var(--ink); transition: box-shadow 0.3s var(--ease); }
  .site-header--overlay { position: fixed; inset: 0 0 auto; background: transparent; }
  .site-header--overlay.is-stuck, .site-header.nav-open, .site-header.mega-open { background: var(--ink); }
  .is-stuck { box-shadow: 0 6px 24px rgb(2 52 82 / 0.25); }
  .site-header__inner { display: flex; align-items: center; justify-content: space-between; min-height: 84px; transition: min-height 0.3s var(--ease); }
  .is-stuck .site-header__inner { min-height: 68px; }
  .site-header__logo img { width: 112px; height: auto; }

  .site-nav__list { display: flex; align-items: center; gap: 2px; list-style: none; margin: 0; padding: 0; }
  .site-nav__top { position: relative; display: flex; align-items: center; gap: 6px; min-height: 44px; padding: 0 1rem; font: inherit; font-size: 13px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--white); background: none; border: 0; cursor: pointer; }
  .site-nav__top::after { content: ''; position: absolute; left: 1rem; right: 1rem; bottom: 4px; height: 2px; background: var(--orange); transform: scaleX(0); transform-origin: left; transition: transform 0.25s var(--ease); }
  .site-nav__top:hover { color: var(--orange-soft); }
  .is-section > .site-nav__top::after, .site-nav__top:hover::after, .is-open > .site-nav__top::after { transform: scaleX(1); }
  .chevron { width: 10px; height: 6px; transition: transform 0.25s var(--ease); }
  .is-open .chevron { transform: rotate(180deg); }
  .is-cta { margin-left: 0.75rem; }
  .is-cta > .site-nav__top { background: var(--orange); color: var(--on-orange); border-radius: var(--radius); padding: 0 1.2rem; }
  .is-cta > .site-nav__top::after { display: none; }
  .is-cta > .site-nav__top:hover { background: var(--white); color: var(--navy); }

  /* Mega panel */
  .mega { position: absolute; left: 0; right: 0; top: 100%; background: var(--white); color: var(--text); border-top: 3px solid var(--orange); box-shadow: 0 30px 60px rgb(1 29 49 / 0.25); opacity: 0; visibility: hidden; transform: translateY(-6px); transition: opacity 0.2s var(--ease), transform 0.2s var(--ease), visibility 0.2s; }
  .is-open > .mega { opacity: 1; visibility: visible; transform: none; }
  .mega__grid { display: grid; grid-template-columns: minmax(220px, 1.1fr) repeat(auto-fit, minmax(180px, 1fr)); gap: var(--s7); padding-block: var(--s7) var(--s8); }
  .mega__intro { padding-right: var(--s5); border-right: 1px solid var(--border); }
  .mega__title { margin: 0 0 var(--s3); font-size: 2rem; font-weight: 900; letter-spacing: -0.02em; line-height: 1.05; color: var(--navy); }
  .mega__intro p:not(.mega__title) { font-size: var(--fs-sm); margin-bottom: var(--s4); }
  .mega__heading { margin: 0 0 var(--s3); font-size: var(--fs-sm); font-weight: 700; letter-spacing: 0;  color: var(--orange-text); }
  .mega ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .mega__col a, .mega__events a { display: flex; flex-direction: column; gap: 2px; padding: var(--s2) var(--s3); margin-left: calc(-1 * var(--s3)); border-radius: 6px; color: var(--text); }
  .mega__col a:hover, .mega__events a:hover { background: var(--grey-light); color: var(--text); }
  .mega__link { font-weight: 700; color: var(--navy); line-height: 1.3; }
  a:hover > .mega__link, a:hover .mega__link { color: var(--orange-text); }
  .mega__desc { font-size: var(--fs-xs); color: var(--muted); line-height: 1.35; }
  .mega__col a[aria-current='page'] .mega__link { color: var(--orange-text); }
  .mega__feature--wide { grid-column: span 2; }
  .mega__clubs { padding: var(--s4); margin: calc(-1 * var(--s4)); border-radius: var(--radius-lg); background: var(--grey-light); }
  .mega__clubs ul { gap: var(--s1); }
  .mega__clubs a { display: flex; align-items: center; gap: var(--s3); padding: 6px; border-radius: 8px; }
  .mega__clubs a:hover { background: var(--white); }
  .mega__clubs .icon-disc { width: 40px; border: 0; }
  .mega__clubs .mega__link { font-size: var(--fs-sm); }
  .site-nav__mobile-link { display: none !important; }
  .mega__events a { flex-direction: row; align-items: center; gap: var(--s4); }
  .mega__date { flex: none; display: flex; flex-direction: column; align-items: center; width: 52px; padding: 4px 0; border-radius: 6px; background: var(--navy); color: var(--white); font-size: 11px; text-transform: uppercase; line-height: 1.1; }
  .mega__date b { font-size: 1.3rem; font-weight: 900; }
  .mega__events a > span:last-child { display: flex; flex-direction: column; gap: 2px; }
  .mega__feature--news { grid-column: span 3; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s5); }
  .mega__story { display: flex; flex-direction: column; gap: 6px; color: var(--text); }
  .mega__story:hover { color: var(--text); }
  .mega__img { display: block; aspect-ratio: 16 / 9; border-radius: 8px; overflow: hidden; background: var(--grey-light); margin-bottom: 4px; }
  .mega__img :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .mega__map { display: flex; align-items: center; gap: var(--s4); padding: var(--s4); border-radius: var(--radius-lg); background: var(--ink); color: #c9d7e2; font-size: var(--fs-sm); }
  .mega__map:hover { color: var(--white); }
  .mega__map :global(.ukmap) { width: 110px; flex: none; }
  .mega__map b { display: block; font-size: 2.4rem; font-weight: 900; color: var(--white); line-height: 1; }
  .mega-scrim { position: fixed; inset: 0; top: auto; height: 100vh; z-index: -1; background: rgb(1 29 49 / 0.45); }
  .mega-scrim:not([hidden]) { top: 0; }

  .site-header__toggle { display: none; }
  .site-header__inner { gap: var(--s2); }
  .site-nav { margin-left: auto; }
  .site-header__search { order: 3; display: grid; place-items: center; width: 44px; height: 44px; margin-left: var(--s2); border-radius: 50%; color: var(--white); }
  .site-header__search:hover { background: rgb(255 255 255 / 0.1); color: var(--orange-soft); }
  .site-header__search svg { width: 20px; height: 20px; }

  @media (max-width: 1024px) {
    .site-header__toggle { display: grid; place-items: center; width: 44px; height: 44px; background: none; border: 0; cursor: pointer; }
    .site-header__toggle span[aria-hidden], .site-header__toggle span[aria-hidden]::before, .site-header__toggle span[aria-hidden]::after { display: block; width: 24px; height: 2px; background: var(--white); position: relative; content: ''; transition: transform 0.25s var(--ease); }
    .site-header__toggle span[aria-hidden]::before { position: absolute; top: -7px; }
    .site-header__toggle span[aria-hidden]::after { position: absolute; top: 7px; }
    .nav-open .site-header__toggle span[aria-hidden] { background: transparent; }
    .nav-open .site-header__toggle span[aria-hidden]::before { transform: translateY(7px) rotate(45deg); }
    .nav-open .site-header__toggle span[aria-hidden]::after { transform: translateY(-7px) rotate(-45deg); }
    .site-nav { position: absolute; inset: 100% 0 auto; background: var(--ink); max-height: 0; overflow: hidden; transition: max-height 0.35s var(--ease); }
    .nav-open .site-nav { max-height: calc(100dvh - 68px); height: calc(100dvh - 68px); overflow-y: auto; }
    .site-header__toggle { order: 4; }
    .site-header__search { margin-left: auto; }
    .site-nav__list { flex-direction: column; align-items: stretch; padding: var(--s2) var(--gutter) var(--s6); }
    .site-nav__item { border-bottom: 1px solid rgb(255 255 255 / 0.1); }
    .site-nav__top { width: 100%; justify-content: space-between; min-height: 56px; padding: 0; font-size: 14px; }
    .site-nav__top::after { display: none; }
    .is-cta { margin: var(--s5) 0 0; border: 0; }
    .is-cta > .site-nav__top { justify-content: center; }
    .mega { position: static; display: none; opacity: 1; visibility: visible; transform: none; background: transparent; box-shadow: none; border: 0; color: var(--on-dark); }
    .is-open > .mega { display: block; }
    .mega__grid { display: flex; flex-direction: column; gap: var(--s4); padding: 0 0 var(--s5); width: 100%; }
    .mega__feature { display: none; }
    .mega__intro { border: 0; padding: 0; order: 9; }
    .mega__intro p { display: none; }
    .mega__intro .more-link { color: var(--orange-soft); }
    .mega__heading { color: var(--orange-soft); }
    .mega__col a { margin-left: 0; padding: var(--s2) 0; }
    .mega__link { color: var(--white); }
    .mega__desc { color: #9fbcd0; }
    .mega__col a:hover { background: none; }
    .mega-scrim { display: none; }
    .site-nav__mobile-link { display: flex !important; }
    .site-nav__desktop-only, .site-nav__desktop-only + .mega { display: none !important; }
  }
</style>
