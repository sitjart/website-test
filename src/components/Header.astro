---
import nav from '../data/navigation.json';
import { url } from '../lib/url';

interface Props { overlay?: boolean }
const { overlay = false } = Astro.props;
const current = Astro.url.pathname;
// A top-level item is "current" when the page sits anywhere in its section
const inSection = (item: { href: string; children?: { href: string }[] }) =>
  [item.href, ...(item.children ?? []).map((c) => c.href)].some((h) => h !== '/' && current.startsWith(url(h)));
---
<header class:list={['site-header', { 'site-header--overlay': overlay }]} data-header>
  <div class="container site-header__inner">
    <a class="site-header__logo" href={url('/')}>
      <img src={url('/images/elixir-uk-logo.svg')} alt="ELIXIR United Kingdom" width="112" height="38" />
    </a>

    <button class="site-header__toggle" aria-expanded="false" aria-controls="primary-nav" data-nav-toggle>
      <span class="visually-hidden">Menu</span>
      <span aria-hidden="true"></span>
    </button>

    <nav id="primary-nav" class="site-nav" aria-label="Main">
      <ul>
        {nav.map((item) => (
          <li class:list={{ 'has-children': item.children, 'is-cta': (item as { cta?: boolean }).cta, 'is-section': inSection(item) }}>
            <a href={url(item.href)} aria-current={current === url(item.href) ? 'page' : undefined}>
              {item.label}
              {item.children && <svg class="chevron" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>}
            </a>
            {item.children && (
              <ul class="site-nav__sub">
                {item.children.map((c) => <li><a href={url(c.href)} aria-current={current === url(c.href) ? 'page' : undefined}>{c.label}</a></li>)}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  // Sticky header: transparent over the hero, navy once the page scrolls (as on the live site).
  const header = document.querySelector<HTMLElement>('[data-header]');
  const onScroll = () => header?.classList.toggle('is-stuck', window.scrollY > 40);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    header?.classList.toggle('nav-open', !open);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && header?.classList.contains('nav-open')) { toggle?.click(); toggle?.focus(); }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--ink);
    transition: background 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }
  .site-header--overlay {
    position: fixed;
    inset: 0 0 auto;
    background: transparent;
  }
  .site-header--overlay.is-stuck,
  .site-header.nav-open {
    background: var(--ink);
    box-shadow: 0 6px 24px rgb(2 52 82 / 0.25);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 90px;
    transition: min-height 0.3s var(--ease);
  }
  .is-stuck .site-header__inner { min-height: 70px; }
  .site-header__logo img { width: 112px; height: auto; }

  .site-nav > ul {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-nav li { position: relative; }
  .site-nav > ul > li > a {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.75rem 1.1rem;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--white);
  }
  .site-nav > ul { align-items: center; }
  .site-nav > ul > li > a { position: relative; min-height: 44px; }
  .site-nav > ul > li > a::after { content: ''; position: absolute; left: 1.1rem; right: 1.1rem; bottom: 4px; height: 2px; background: var(--orange); transform: scaleX(0); transform-origin: left; transition: transform 0.25s var(--ease); }
  .site-nav > ul > li > a:hover { color: var(--orange-soft); }
  .site-nav > ul > li.is-section > a::after, .site-nav > ul > li > a:hover::after { transform: scaleX(1); }
  .site-nav > ul > li.is-cta { margin-left: 0.75rem; }
  .site-nav > ul > li.is-cta > a { background: var(--orange); color: var(--on-orange); border-radius: var(--radius); padding: 0.6rem 1.2rem; }
  .site-nav > ul > li.is-cta > a::after { display: none; }
  .site-nav > ul > li.is-cta > a:hover { background: var(--white); color: var(--navy); }
  .site-nav__sub a[aria-current='page'] { color: var(--orange-text); font-weight: 700; }
  .chevron { width: 9px; height: 6px; }

  .site-nav__sub {
    position: absolute;
    top: 100%;
    left: 0.5rem;
    min-width: 240px;
    list-style: none;
    margin: 0;
    padding: 0.6rem 0;
    background: var(--white);
    border-radius: 6px;
    box-shadow: 0 20px 40px rgb(2 52 82 / 0.18);
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: opacity 0.25s var(--ease), transform 0.25s var(--ease), visibility 0.25s;
  }
  .has-children:hover .site-nav__sub,
  .has-children:focus-within .site-nav__sub {
    opacity: 1;
    visibility: visible;
    transform: none;
  }
  .site-nav__sub a {
    display: block;
    padding: 0.55rem 1.25rem;
    font-size: 15px;
    color: var(--navy);
  }
  .site-nav__sub a:hover { background: var(--grey-light); color: var(--blue); }

  .site-header__toggle { display: none; }

  @media (max-width: 960px) {
    .site-header__toggle {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      background: none;
      border: 0;
      cursor: pointer;
    }
    .site-header__toggle span[aria-hidden],
    .site-header__toggle span[aria-hidden]::before,
    .site-header__toggle span[aria-hidden]::after {
      display: block;
      width: 24px;
      height: 2px;
      background: var(--white);
      position: relative;
      content: '';
    }
    .site-header__toggle span[aria-hidden]::before { position: absolute; top: -7px; }
    .site-header__toggle span[aria-hidden]::after { position: absolute; top: 7px; }

    .site-nav {
      position: absolute;
      inset: 100% 0 auto;
      background: var(--navy);
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.35s var(--ease);
    }
    .nav-open .site-nav { max-height: 80vh; overflow-y: auto; }
    .site-nav > ul { flex-direction: column; align-items: stretch; padding: 0.5rem 1.25rem 1.5rem; }
    .site-nav > ul > li > a::after { display: none; }
    .site-nav > ul > li.is-cta { margin: 0.75rem 0 0; }
    .site-nav > ul > li.is-cta > a { justify-content: center; }
    .site-nav__sub {
      position: static;
      opacity: 1;
      visibility: visible;
      transform: none;
      background: transparent;
      box-shadow: none;
      padding: 0 0 0.5rem 1rem;
    }
    .site-nav__sub a { color: rgb(255 255 255 / 0.8); padding: 0.4rem 1rem; }
    .site-nav__sub a:hover { background: transparent; color: var(--orange); }
  }
</style>
