---
// B2 title banner for inner pages: crumb, display title with the orange stop, lead, optional figure and illustration.
import { asset } from '../lib/assets';
import { needsStop } from '../lib/format';
import { url } from '../lib/url';

interface Props {
  title: string;
  eyebrow?: string;
  intro?: string;
  crumb?: { label: string; href: string };
  illustration?: string; // file in public/assets/wp
  count?: { n: number; label: string };
  size?: 'lg' | 'md';
}
const { title, eyebrow, intro, crumb, illustration, count, size = 'lg' } = Astro.props;
---
<header class:list={['banner', 'ph', `ph--${size}`, { 'ph--art': illustration }]}>
  <svg class="ph__mark" aria-hidden="true" viewBox="0 0 200 200"><circle cx="100" cy="100" r="99" fill="none" stroke="currentColor" stroke-width="1" /><circle cx="100" cy="100" r="64" fill="none" stroke="currentColor" stroke-width="1" /></svg>
  <div class="container ph__grid">
    <div class="ph__copy">
      {crumb && <p class="crumb"><a href={url(crumb.href)}>{crumb.label}</a></p>}
      {eyebrow && <p class="eyebrow-sm ph__eyebrow">{eyebrow}</p>}
      <h1 class="display ph__title">{title}{needsStop(title) && <span class="stop">.</span>}</h1>
      {intro && <p class="ph__intro">{intro}</p>}
      <slot />
    </div>
    {(illustration || count) && (
      <div class="ph__side">
        {illustration && <img class="ph__art" src={asset(illustration)} alt="" />}
        {count && <p class="ph__count"><b>{count.n}</b><span>{count.label}</span></p>}
      </div>
    )}
  </div>
</header>

<style>
  .ph { padding-block: clamp(48px, 6vw, 80px); }
  .ph--md { padding-block: clamp(40px, 5vw, 64px); }
  .ph__mark { position: absolute; right: -140px; top: -160px; width: 520px; color: rgb(255 255 255 / 0.06); pointer-events: none; }
  .ph__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(24px, 4vw, 64px); align-items: center; }
  .ph--art .ph__grid, .ph__grid:has(.ph__side) { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); }
  .ph__eyebrow { color: var(--orange-soft); }
  .ph__title { font-size: clamp(2.4rem, 1.6rem + 3vw, 4rem); margin: 0; max-width: 18ch; }
  .ph--md .ph__title { font-size: clamp(2rem, 1.4rem + 2.2vw, 3.2rem); max-width: 26ch; }
  .ph__intro { margin: var(--s5) 0 0; max-width: 40rem; font-size: var(--fs-lead); line-height: 1.55; color: var(--on-dark); }
  .ph__side { display: flex; flex-direction: column; align-items: flex-end; gap: var(--s4); }
  .ph__art { width: 100%; max-width: 360px; max-height: 260px; object-fit: contain; filter: invert(1) hue-rotate(180deg) brightness(1.1); mix-blend-mode: screen; opacity: 0.9; }
  .ph__count { display: flex; align-items: baseline; gap: var(--s3); margin: 0; }
  .ph__count b { font-size: clamp(3rem, 2rem + 3vw, 5rem); font-weight: 900; line-height: 1; color: var(--white); letter-spacing: -0.03em; }
  .ph__count span { max-width: 9rem; font-size: var(--fs-sm); line-height: 1.35; color: #9fbcd0; }
  @media (max-width: 800px) {
    .ph--art .ph__grid, .ph__grid:has(.ph__side) { grid-template-columns: 1fr; }
    .ph__side { align-items: flex-start; }
    .ph__art { display: none; }
  }
</style>
