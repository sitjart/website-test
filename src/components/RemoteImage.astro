---
// Resizes and converts remote images (still hosted on WordPress) to WebP at build time,
// so visitors download a small file instead of the full-size original.
// If the image can't be fetched during the build it falls back to the original URL.
import { getImage } from 'astro:assets';
import { localAsset } from '../lib/assets';

interface Props {
  src: string;
  alt?: string;
  width: number;
  class?: string;
  loading?: 'lazy' | 'eager';
  fit?: 'cover' | 'contain';
}
const { src, alt = '', width, class: className, loading = 'lazy' } = Astro.props;

const isSvg = /\.svg(\?|$)/i.test(src);
// SVGs: serve the repo copy when there is one. Photos: optimise from the original, local copy as fallback.
let out = { src: isSvg ? localAsset(src)! : src, attributes: {} as Record<string, unknown> };
if (!isSvg) {
  try {
    const img = await getImage({ src, inferSize: true, width, format: 'webp', quality: 78 });
    out = { src: img.src, attributes: img.attributes };
  } catch {
    out.src = localAsset(src)!;
  }
}
---
<img src={out.src} {alt} class={className} loading={loading} decoding="async" width={out.attributes.width as number | undefined} height={out.attributes.height as number | undefined} />
