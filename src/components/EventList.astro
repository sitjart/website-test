---
// Events: upcoming as date cards; past as a compact list by year, filterable by type.
import type { CollectionEntry } from 'astro:content';
import { todayUK } from '../lib/format';
import { url } from '../lib/url';
import { tagSlug } from '../lib/graph';

interface Props { items: CollectionEntry<'events'>[] }
const today = todayUK();
const upcoming = Astro.props.items.filter((e) => (e.data.end ?? e.data.start) >= today).sort((a, b) => a.data.start.getTime() - b.data.start.getTime());
const past = Astro.props.items.filter((e) => (e.data.end ?? e.data.start) < today).sort((a, b) => b.data.start.getTime() - a.data.start.getTime());
const years = [...new Set(past.map((e) => e.data.start.getUTCFullYear()))];
const types = [...new Set(past.map((e) => e.data.type))].map((t) => ({ t, n: past.filter((e) => e.data.type === t).length })).sort((a, b) => b.n - a.n);
const f = (d: Date, o: Intl.DateTimeFormatOptions) => d.toLocaleDateString('en-GB', { ...o, timeZone: 'UTC' });
const where = (e: CollectionEntry<'events'>) => (e.data.format === 'online' ? 'Online' : e.data.format === 'hybrid' ? `Hybrid${e.data.locality ? ` · ${e.data.locality}` : ''}` : e.data.locality || 'In person');
---
{upcoming.length > 0 && (
  <section class="section">
    <div class="container">
      <div class="section-head"><h2 class="section-title">Upcoming<span class="stop">.</span></h2></div>
      <ul class="up">
        {upcoming.map((e) => (
          <li><a class="card upcard" href={url(`/events/${e.id}/`)}>
            <span class="upcard__date"><span>{f(e.data.start, { month: 'short' })}</span><b>{f(e.data.start, { day: 'numeric' })}</b><span>{f(e.data.start, { weekday: 'short' })}</span></span>
            <span class="upcard__body">
              <span class="card__meta">{e.data.type}</span>
              <span class="card__title">{e.data.title}</span>
              <span class="upcard__where">{where(e)}{e.data.startTime && ` · ${e.data.startTime} UK time`}</span>
            </span>
          </a></li>
        ))}
      </ul>
    </div>
  </section>
)}
{past.length > 0 && (
  <section class="section section--grey">
    <div class="container">
      <div class="section-head">
        <div><h2 class="section-title">Past events<span class="stop">.</span></h2><p>{past.length} events, with recordings and slides where we have them.</p></div>
      </div>
      <div class="filters" role="group" aria-label="Filter by type">
        <button type="button" class="chip is-active" data-type="" aria-pressed="true">All <span>{past.length}</span></button>
        {types.map(({ t, n }) => <button type="button" class="chip" data-type={tagSlug(t)} aria-pressed="false">{t} <span>{n}</span></button>)}
      </div>
      {years.map((y) => (
        <section class="year" data-year>
          <h3 class="year__h">{y}</h3>
          <ul class="past">
            {past.filter((e) => e.data.start.getUTCFullYear() === y).map((e) => (
              <li data-type={tagSlug(e.data.type)}><a href={url(`/events/${e.id}/`)}>
                <span class="past__date"><b>{f(e.data.start, { day: 'numeric' })}</b>{f(e.data.start, { month: 'short' })}</span>
                <span class="past__main">
                  <span class="past__title">{e.data.title}</span>
                  <span class="past__meta">{e.data.type} · {where(e)}</span>
                </span>
                <span class="past__extra">{e.data.recording && <span class="rec">▶ Recording</span>}{e.data.slides && <span class="rec">Slides</span>}</span>
              </a></li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </section>
)}

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('[data-type]:is(button)');
  const rows = document.querySelectorAll<HTMLElement>('.past li');
  chips.forEach((ch) => ch.addEventListener('click', () => {
    const t = ch.dataset.type ?? '';
    chips.forEach((c) => { const on = c === ch; c.classList.toggle('is-active', on); c.setAttribute('aria-pressed', String(on)); });
    rows.forEach((r) => (r.hidden = !!t && r.dataset.type !== t));
    document.querySelectorAll<HTMLElement>('[data-year]').forEach((y) => (y.hidden = !y.querySelector('li:not([hidden])')));
  }));
</script>

<style>
  .up { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 380px), 1fr)); gap: var(--s4); }
  .up li { display: flex; }
  .upcard { flex: 1; flex-direction: row; gap: var(--s5); align-items: flex-start; }
  .upcard__date { display: flex; flex-direction: column; align-items: center; flex: none; width: 72px; padding: var(--s2) 0; border-radius: 8px; background: var(--navy); color: var(--white); line-height: 1.1; }
  .upcard__date span { font-size: var(--fs-xs); text-transform: uppercase; letter-spacing: 0.08em; color: #9fbcd0; }
  .upcard__date b { font-size: 2rem; font-weight: 900; }
  .upcard__body { display: flex; flex-direction: column; gap: var(--s1); }
  .upcard__where { font-size: var(--fs-sm); color: var(--muted); }
  .filters { display: flex; flex-wrap: wrap; gap: var(--s2); margin-bottom: var(--s6); }
  .chip { font: inherit; font-size: var(--fs-sm); min-height: 40px; padding: 0 var(--s4); border: 1px solid var(--border); border-radius: 999px; background: var(--white); color: var(--navy); cursor: pointer; }
  .chip span { color: var(--muted); font-size: var(--fs-xs); }
  .chip.is-active { background: var(--navy); border-color: var(--navy); color: var(--white); }
  .chip.is-active span { color: #9fbcd0; }
  .year { display: grid; grid-template-columns: 120px minmax(0, 1fr); gap: var(--s5); padding-block: var(--s6); border-top: 1px solid #d5dee5; }
  .year__h { margin: 0; font-size: 2rem; font-weight: 900; color: var(--navy); line-height: 1; position: sticky; top: 100px; align-self: start; }
  .past { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s2); }
  .past a { display: grid; grid-template-columns: 56px minmax(0, 1fr) auto; gap: var(--s4); align-items: center; padding: var(--s3) var(--s4); border-radius: 10px; background: var(--white); color: var(--text); transition: box-shadow 0.2s var(--ease); }
  .past a:hover { color: var(--text); box-shadow: var(--shadow-hover); }
  .past__date { display: flex; flex-direction: column; align-items: center; line-height: 1.1; font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); }
  .past__date b { font-size: 1.4rem; font-weight: 900; color: var(--navy); letter-spacing: 0; }
  .past__main { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .past__title { font-weight: 700; color: var(--navy); line-height: 1.3; }
  a:hover .past__title { color: var(--orange-text); }
  .past__meta { font-size: var(--fs-xs); color: var(--muted); }
  .past__extra { display: flex; gap: 6px; }
  .rec { font-size: var(--fs-xs); font-weight: 700; padding: 2px 8px; border-radius: 3px; background: #e3f1f7; color: var(--blue-dark); white-space: nowrap; }
  @media (max-width: 800px) {
    .year { grid-template-columns: 1fr; }
    .year__h { position: static; }
    .past a { grid-template-columns: 48px minmax(0, 1fr); }
    .past__extra { grid-column: 2; }
  }
</style>
