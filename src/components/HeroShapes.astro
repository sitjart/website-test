---
// Hero art: a modular grid of shapes. Organic forms (cells, petals, half-moons, rings) for life;
// bars and dot matrices for data. Every few seconds a handful of tiles turn or swap shape,
// so the grid stays ordered while it moves. Layout is seeded, so every build looks the same.
interface Props { class?: string }
const { class: className } = Astro.props;

const COLS = 7, ROWS = 5, S = 100; // tile size in SVG units
let seed = 7;
const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const pick = <T,>(a: T[]) => a[Math.floor(rnd() * a.length)];

// Palette: ground colour + shape colour pairs that sit well on the ink banner
const PAIRS = [
  ['#023452', '#047eaa'], ['#023452', '#f47d21'], ['#047eaa', '#ffffff'], ['#047eaa', '#023452'],
  ['#0b3a5a', '#ffffff'], ['#f47d21', '#023452'], ['#ffffff', '#047eaa'], ['#0b3a5a', '#f47d21'],
  ['#011d31', '#047eaa'], ['#e9f1f6', '#023452'],
];
const KINDS = ['quarter', 'half', 'circle', 'leaf', 'ring', 'bars', 'dots', 'quarter', 'leaf', 'half'];
const tiles = [];
for (let r = 0; r < ROWS; r++) for (let c = 0; c < COLS; c++) {
  // Fade the grid out towards the left so the copy stays readable: some tiles left empty
  // left edge steps in a regular stair: column 2 on even rows, column 1 on every other even row
  const keep = c >= 3 || (c === 2 && r % 2 === 0) || (c === 1 && r % 4 === 0);
  rnd();
  if (!keep) continue;
  const [bg, fg] = pick(PAIRS);
  tiles.push({ x: c * S, y: r * S, bg, fg, kind: pick(KINDS), rot: Math.floor(rnd() * 4) * 90, c });
}
---
<div class:list={['shapes', className]} aria-hidden="true">
  <svg viewBox={`0 0 ${COLS * S} ${ROWS * S}`} preserveAspectRatio="xMaxYMid slice">
    {tiles.map((t, i) => (
      <g class="tile-s" data-kind={t.kind} style={`--rot:${t.rot}deg; --i:${i}; transform-origin:${t.x + S / 2}px ${t.y + S / 2}px`}>
        <rect class="bg" x={t.x + 1} y={t.y + 1} width={S - 2} height={S - 2} rx="2" fill={t.bg} />
        <g class="fg" fill={t.fg} stroke={t.fg}>
          {/* All shapes are drawn in every tile; data-kind shows one, so a tile can morph by switching kind */}
          <path class="k-quarter" stroke="none" d={`M${t.x + 2} ${t.y + 2} H${t.x + S - 2} A${S - 4} ${S - 4} 0 0 1 ${t.x + 2} ${t.y + S - 2} Z`} />
          <path class="k-half" stroke="none" d={`M${t.x + 2} ${t.y + S / 2} A${S / 2 - 2} ${S / 2 - 2} 0 0 1 ${t.x + S - 2} ${t.y + S / 2} Z`} />
          <circle class="k-circle" stroke="none" cx={t.x + S / 2} cy={t.y + S / 2} r={S / 2 - 12} />
          <path class="k-leaf" stroke="none" d={`M${t.x + 6} ${t.y + S - 6} A${S - 12} ${S - 12} 0 0 1 ${t.x + S - 6} ${t.y + 6} A${S - 12} ${S - 12} 0 0 1 ${t.x + 6} ${t.y + S - 6} Z`} />
          <g class="k-ring" fill="none" stroke-width="9"><circle cx={t.x + S / 2} cy={t.y + S / 2} r={S / 2 - 16} /><circle cx={t.x + S / 2} cy={t.y + S / 2} r="7" fill={t.fg} stroke="none" /></g>
          <g class="k-bars" stroke="none">{[0, 1, 2, 3].map((b) => <rect x={t.x + 16 + b * 19} y={t.y + 16 + [30, 8, 44, 20][b]} width="11" height={68 - [30, 8, 44, 20][b]} rx="5.5" />)}</g>
          <g class="k-dots" stroke="none">{[0, 1, 2, 3].flatMap((a) => [0, 1, 2, 3].map((b) => <circle cx={t.x + 20 + a * 20} cy={t.y + 20 + b * 20} r={(a + b) % 3 === 0 ? 6 : 3.5} />))}</g>
        </g>
      </g>
    ))}
  </svg>
</div>

<script>
  // Every 1.6 s, a few tiles turn a quarter, and now and then one changes shape.
  const KINDS = ['quarter', 'half', 'circle', 'leaf', 'ring', 'bars', 'dots'];
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('.shapes').forEach((root) => {
    if (reduce) return;
    const tiles = [...root.querySelectorAll<SVGGElement>('.tile-s')];
    let visible = true;
    new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(root);
    setInterval(() => {
      if (!visible || document.hidden) return;
      for (let n = 0; n < 4; n++) {
        const t = tiles[Math.floor(Math.random() * tiles.length)];
        const rot = parseInt(getComputedStyle(t).getPropertyValue('--rot')) || 0;
        if (Math.random() < 0.3) {
          t.classList.add('is-swapping');
          setTimeout(() => {
            t.dataset.kind = KINDS[Math.floor(Math.random() * KINDS.length)];
            t.classList.remove('is-swapping');
          }, 380);
        } else {
          t.style.setProperty('--rot', `${rot + 90}deg`);
        }
      }
    }, 1600);
  });
</script>

<style>
  .shapes { position: absolute; inset: 0 0 0 auto; width: min(64%, 900px); z-index: -1; pointer-events: none; }
  .shapes svg { width: 100%; height: 100%; display: block; }
  .shapes::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, var(--ink) 0%, rgb(1 29 49 / 0.35) 22%, rgb(1 29 49 / 0) 36%); }
  .tile-s { transform: rotate(var(--rot)); transition: transform 0.9s cubic-bezier(0.65, 0, 0.35, 1); animation: tile-in 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) both; animation-delay: calc(var(--i) * 18ms); }
  .tile-s .fg > * { display: none; }
  .tile-s[data-kind='quarter'] .k-quarter, .tile-s[data-kind='half'] .k-half, .tile-s[data-kind='circle'] .k-circle,
  .tile-s[data-kind='leaf'] .k-leaf, .tile-s[data-kind='ring'] .k-ring, .tile-s[data-kind='bars'] .k-bars, .tile-s[data-kind='dots'] .k-dots { display: inline; }
  .tile-s .fg { transition: opacity 0.38s ease, transform 0.38s ease; transform-box: fill-box; transform-origin: center; }
  .tile-s.is-swapping .fg { opacity: 0; transform: scale(0.6); }
  @keyframes tile-in { from { opacity: 0; transform: rotate(calc(var(--rot) - 90deg)) scale(0.8); } }
  @media (prefers-reduced-motion: reduce) { .tile-s { animation: none; transition: none; } }
  @media (max-width: 900px) {
    .shapes { position: relative; inset: auto; width: 100%; height: 240px; order: 2; margin-top: var(--s6); }
    .shapes::after { background: linear-gradient(180deg, var(--ink) 0%, rgb(1 29 49 / 0) 30%); }
  }
</style>
<style>
  @media (min-width: 901px) and (max-width: 1240px) { .shapes { width: 50%; } }
</style>
