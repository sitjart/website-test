---
// Listing page for a directory (services, members, projects ...), with tag filters
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from './PageHeader.astro';
import RemoteImage from './RemoteImage.astro';
import { DIRECTORY, tagSlug } from '../lib/graph';
import { url } from '../lib/url';

interface Props { kind: keyof typeof DIRECTORY }
const { kind } = Astro.props;
const { title, records, intro } = DIRECTORY[kind];
const tags = [...new Set(records.flatMap((r) => r.tags))].sort();
---
<BaseLayout {title}>
  <PageHeader {title} {intro} />
  <section class="section">
    <div class="container">
      {tags.length > 1 && (
        <div class="filters" role="group" aria-label="Filter">
          <button type="button" class="chip is-active" data-filter="">All ({records.length})</button>
          {tags.map((t) => (
            <button type="button" class="chip" data-filter={tagSlug(t)}>
              {t} ({records.filter((r) => r.tags.includes(t)).length})
            </button>
          ))}
        </div>
      )}
      <ul class="dir-grid">
        {records.map((r) => (
          <li class="dir-card" data-tags={r.tags.map(tagSlug).join(' ')}>
            <a href={url(`/${kind}/${r.slug}/`)}>
              <span class="dir-card__logo">
                {r.logo ? <RemoteImage src={r.logo} width={240} alt="" /> : <span class="dir-card__initial">{r.name[0]}</span>}
              </span>
              <span class="dir-card__name">{r.name}</span>
              {r.tags.length > 0 && <span class="dir-card__tags">{r.tags.join(' · ')}</span>}
            </a>
          </li>
        ))}
      </ul>
      <p class="filters__empty" hidden>Nothing matches this filter.</p>
    </div>
  </section>
</BaseLayout>

<script>
  // Tag filter: show only cards carrying the chosen tag; the choice is kept in the URL (#tag)
  const chips = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('.dir-card');
  const empty = document.querySelector<HTMLElement>('.filters__empty');
  const apply = (tag: string) => {
    let shown = 0;
    cards.forEach((c) => {
      const ok = !tag || (c.dataset.tags ?? '').split(' ').includes(tag);
      c.hidden = !ok;
      if (ok) shown++;
    });
    chips.forEach((ch) => ch.classList.toggle('is-active', ch.dataset.filter === tag));
    if (empty) empty.hidden = shown > 0;
  };
  chips.forEach((ch) => ch.addEventListener('click', () => {
    const tag = ch.dataset.filter ?? '';
    history.replaceState(null, '', tag ? `#${tag}` : location.pathname);
    apply(tag);
  }));
  apply(location.hash.slice(1));
</script>

<style>
  .filters { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 2.5rem; }
  .chip {
    font: inherit;
    font-size: 14px;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--white);
    color: var(--navy);
    cursor: pointer;
    transition: background 0.2s var(--ease), color 0.2s var(--ease), border-color 0.2s var(--ease);
  }
  .chip:hover { border-color: var(--orange); }
  .chip.is-active { background: var(--orange); border-color: var(--orange); color: var(--white); }
  .dir-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1.5rem;
  }
  .dir-card a {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.5rem;
    background: var(--white);
    border-radius: 10px;
    box-shadow: 0 20px 40px rgb(225 232 237 / 0.7);
    color: var(--text);
    transition: transform 0.25s var(--ease), box-shadow 0.25s var(--ease);
  }
  .dir-card a:hover { transform: translateY(-4px); box-shadow: 0 24px 48px rgb(2 52 82 / 0.12); color: var(--text); }
  .dir-card__logo { display: grid; place-items: center; height: 110px; margin-bottom: 1rem; }
  .dir-card__logo :global(img) { max-height: 100%; max-width: 100%; object-fit: contain; }
  .dir-card__initial { display: grid; place-items: center; width: 80px; height: 80px; border-radius: 50%; background: var(--navy); color: var(--white); font-size: 2rem; font-weight: 700; }
  .dir-card__name { font-weight: 700; color: var(--navy); line-height: 1.3; }
  .dir-card__tags { font-size: 13px; color: var(--orange); margin-top: 0.4rem; }
</style>
