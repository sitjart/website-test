---
import '@fontsource/lato/400.css';
import '@fontsource/lato/700.css';
import '@fontsource/lato/900.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  overlayHeader?: boolean; // transparent header over a hero, as on the live home page
  jsonLd?: Record<string, unknown>;
}
const { title, description = site.description, overlayHeader = false, jsonLd } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.tagline}`;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={url('/images/favicon.svg')} type="image/svg+xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header overlay={overlayHeader} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      // Scroll-reveal: same effect as the AOS library on the live site, without the library.
      const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if (!('IntersectionObserver' in window)) {
        els.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => {
            if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
          }),
          { rootMargin: '0px 0px -10% 0px' },
        );
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
